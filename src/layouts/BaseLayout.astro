---
interface Props {
  title: string;
  description?: string;
}
const { title, description = "동시성 제어, 쿼리·인덱스 최적화, 오픈소스 기여를 해온 백엔드 개발자 심현민" } = Astro.props;
const github = "https://github.com/stlahxm";
const path = Astro.url.pathname;
const isHome = path === "/";
const isAbout = path.startsWith("/about");
---

<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link
      rel="stylesheet"
      as="style"
      crossorigin
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.css"
    />
  </head>
  <body>
    <div class="layout">
      <aside class="side-nav">
        <a href="/" class="brand">심현민</a>
        <nav class="side-links">
          <a href="/" class:list={[{ active: isHome }]}>
            <span class="side-index">01</span>글
          </a>
          <a href="/about" class:list={[{ active: isAbout }]}>
            <span class="side-index">02</span>소개
          </a>
          <a href={github} target="_blank" rel="noreferrer">
            <span class="side-index">03</span>GitHub ↗
          </a>
        </nav>
      </aside>

      <div class="page">
        <slot />

        <footer class="site-footer">
          <p class="copyright">© 2026 심현민</p>
        </footer>
      </div>
    </div>

    <script>
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.1, rootMargin: "0px 0px -40px 0px" },
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
    </script>

    <style is:global>
      :root {
        --bg: #ffffff;
        --border: #e5e5e5;
        --text: #1a1a1a;
        --text-muted: #767676;
        --text-heading: #111111;
        --accent: #2563eb;
        --tint: #f4f6fb;
        --max-width: 640px;
        --max-width-wide: 1600px;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #0b0b0c;
          --border: #262626;
          --text: #e6e6e6;
          --text-muted: #8a8a8a;
          --text-heading: #ffffff;
          --accent: #60a5fa;
          --tint: #17181c;
        }
      }

      * {
        box-sizing: border-box;
      }
      .reveal {
        opacity: 0;
        transform: translateY(14px);
        transition: opacity 0.5s ease, transform 0.5s ease;
      }
      .reveal.is-visible {
        opacity: 1;
        transform: none;
      }
      @media (prefers-reduced-motion: reduce) {
        .reveal {
          opacity: 1;
          transform: none;
          transition: none;
        }
      }
      html {
        scroll-behavior: smooth;
        /* 모든 페이지의 rem 값은 이 기준으로 계산됨 — 여기를 올리면 사이트 전체
           폰트 크기가 비율을 유지한 채 같이 커진다. 브라우저 기본(16px) 대비 약 18% 확대. */
        font-size: 19px;
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: "Pretendard", -apple-system, BlinkMacSystemFont,
          "Apple SD Gothic Neo", "Segoe UI", sans-serif;
        line-height: 1.65;
        font-size: 1rem;
        -webkit-font-smoothing: antialiased;
      }
      a {
        color: var(--accent);
        text-decoration: none;
      }
      a:hover {
        text-decoration: underline;
      }

      .layout {
        display: flex;
        align-items: flex-start;
        min-height: 100vh;
      }
      .side-nav {
        position: sticky;
        top: 0;
        flex: 0 0 200px;
        width: 200px;
        height: 100vh;
        padding: 2.5rem 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 3rem;
        border-right: 1px solid var(--border);
      }
      .brand {
        font-weight: 600;
        color: var(--text-heading);
      }
      .side-links {
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
        font-size: 0.88rem;
      }
      .side-links a {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        color: var(--text-muted);
        position: relative;
        padding-left: 0.9rem;
        transition: color 0.15s, transform 0.15s;
      }
      .side-links a::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0.15em;
        bottom: 0.15em;
        width: 2px;
        background: transparent;
        transition: background 0.15s;
      }
      .side-links a:hover {
        color: var(--accent);
        text-decoration: none;
        transform: translateX(2px);
      }
      .side-links a.active {
        color: var(--text-heading);
        font-weight: 700;
      }
      .side-links a.active::before {
        background: var(--accent);
      }
      .side-index {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.72rem;
        color: var(--text-muted);
      }

      .page {
        flex: 1;
        min-width: 0;
      }

      .site-footer {
        max-width: var(--max-width-wide);
        margin: 4rem auto 0;
        padding: 1.5rem 1.25rem 3rem;
        border-top: 1px solid var(--border);
        color: var(--text-muted);
        font-size: 0.85rem;
      }
      .copyright {
        margin-top: 0.4rem;
        font-size: 0.78rem;
      }

      @media (max-width: 820px) {
        .layout {
          flex-direction: column;
        }
        .side-nav {
          position: static;
          width: 100%;
          height: auto;
          flex-direction: row;
          align-items: center;
          justify-content: space-between;
          gap: 1rem;
          padding: 1.1rem 1.25rem;
          border-right: none;
          border-bottom: 1px solid var(--border);
        }
        .side-links {
          flex-direction: row;
          gap: 1.1rem;
        }
        .side-links a {
          padding-left: 0;
        }
        .side-links a::before {
          left: 50%;
          top: auto;
          bottom: -0.4rem;
          width: 60%;
          height: 2px;
          transform: translateX(-50%);
        }
      }
    </style>
  </body>
</html>
