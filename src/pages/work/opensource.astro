---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { openSource } from "../../data/opensource";

const totalIssues = openSource.reduce((sum, r) => sum + r.items.length, 0);

function repoShort(repo: string) {
  return repo.split("/")[1] ?? repo;
}
function repoUrl(repo: string) {
  return `https://github.com/${repo}`;
}
function prNumber(prUrl: string) {
  return "#" + prUrl.split("/").pop();
}
function pad(n: number) {
  return String(n).padStart(2, "0");
}
---

<BaseLayout
  title="오픈소스 기여 · 심현민"
  description="redisson, ShedLock, langchain4j 등 오픈소스에 기여한 이슈·PR 기록"
>
  <main>
    <a class="back" href="/about">← 소개로</a>

    <header class="page-header">
      <p class="eyebrow">OPEN SOURCE · {openSource.length} repos · {totalIssues} PRs</p>
      <h1>오픈소스</h1>
    </header>

    <img class="banner" src="/images/opensource-pr.gif" alt="오픈소스 PR 기록" />

    <div class="repos">
      {
        openSource.map((repo) => (
          <section class="repo">
            <div class="repo-head">
              <div>
                <h2>{repo.repo}</h2>
                <p class="repo-desc">
                  {repo.items.length}건의 이슈 리포트·PR로 기여했습니다.
                </p>
              </div>
              <div class="repo-head-right">
                <span class="count">{repo.items.length} PRs</span>
                <a class="repo-link" href={repoUrl(repo.repo)} target="_blank" rel="noreferrer">
                  GitHub 저장소 ↗
                </a>
              </div>
            </div>
            <ul>
              {repo.items.map((item, i) => (
                <li>
                  <span class="item-index">PR {pad(i + 1)}</span>
                  <div class="item-main">
                    <p class="item-title">
                      {item.title}{" "}
                      <span class="item-ref">
                        {repoShort(repo.repo)} {prNumber(item.pr)}
                      </span>
                    </p>
                    <p class="item-desc">{item.desc}</p>
                  </div>
                  <a class="item-pr" href={item.pr} target="_blank" rel="noreferrer">
                    {prNumber(item.pr)} ↗
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </main>

  <style>
    main {
      max-width: 960px;
      margin: 0 auto;
      padding: 3rem 2rem 4rem;
    }
    .back {
      font-size: 0.85rem;
      color: var(--text-muted);
    }
    .page-header {
      margin: 1.6rem 0 2rem;
    }
    .eyebrow {
      font-size: 0.78rem;
      color: var(--text-muted);
      margin: 0 0 0.5rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }
    h1 {
      font-size: 1.7rem;
      margin: 0;
      color: var(--text-heading);
    }

    .banner {
      display: block;
      width: 100%;
      border-radius: 14px;
      border: 1px solid var(--border);
      margin-bottom: 2.5rem;
    }

    .repo {
      margin-bottom: 2.8rem;
    }
    .repo:last-child {
      margin-bottom: 0;
    }
    .repo-head {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 1rem;
      border-bottom: 1px solid var(--border);
      padding-bottom: 1rem;
      margin-bottom: 0.5rem;
      flex-wrap: wrap;
    }
    .repo-head h2 {
      font-size: 1.05rem;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-weight: 700;
      color: var(--text-heading);
      margin: 0 0 0.35rem;
    }
    .repo-desc {
      font-size: 0.85rem;
      color: var(--text-muted);
      margin: 0;
    }
    .repo-head-right {
      display: flex;
      align-items: center;
      gap: 0.7rem;
      flex-shrink: 0;
    }
    .count {
      font-size: 0.78rem;
      color: var(--text-muted);
    }
    .repo-link {
      font-size: 0.78rem;
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 0.3rem 0.8rem;
      color: var(--text);
      white-space: nowrap;
    }
    .repo-link:hover {
      border-color: var(--accent);
      color: var(--accent);
      text-decoration: none;
    }

    .repo ul {
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .repo li {
      display: flex;
      align-items: flex-start;
      gap: 1.2rem;
      padding: 1.2rem 0;
      border-bottom: 1px dashed var(--border);
    }
    .repo li:last-child {
      border-bottom: none;
    }
    .item-index {
      flex: 0 0 auto;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.75rem;
      color: var(--text-muted);
      padding-top: 0.15rem;
    }
    .item-main {
      flex: 1;
      min-width: 0;
    }
    .item-title {
      font-weight: 600;
      font-size: 0.92rem;
      color: var(--text);
      margin: 0 0 0.35rem;
    }
    .item-ref {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-weight: 400;
      font-size: 0.78rem;
      color: var(--text-muted);
    }
    .item-desc {
      font-size: 0.86rem;
      color: var(--text-muted);
      margin: 0;
      max-width: 65ch;
    }
    .item-pr {
      flex: 0 0 auto;
      font-size: 0.8rem;
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 0.25rem 0.7rem;
      color: var(--text);
      white-space: nowrap;
    }
    .item-pr:hover {
      border-color: var(--accent);
      color: var(--accent);
      text-decoration: none;
    }

    @media (max-width: 600px) {
      .repo li {
        flex-direction: column;
        gap: 0.5rem;
      }
    }
  </style>
</BaseLayout>
