---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { openSource } from "../../data/opensource";

const totalIssues = openSource.reduce((sum, r) => sum + r.items.length, 0);

function repoShort(repo: string) {
  return repo.split("/")[1] ?? repo;
}
function repoUrl(repo: string) {
  return `https://github.com/${repo}`;
}
function prNumber(prUrl: string) {
  return "#" + prUrl.split("/").pop();
}
function pad(n: number) {
  return String(n).padStart(2, "0");
}
---

<BaseLayout
  title="오픈소스 기여 · 심현민"
  description="redisson, ShedLock, langchain4j 등 오픈소스에 기여한 이슈·PR 기록"
>
  <main>
    <a class="back" href="/about">← 소개로</a>

    <header class="page-header">
      <p class="eyebrow">OPEN SOURCE · {openSource.length} repos · {totalIssues} PRs</p>
      <h1>오픈소스</h1>
    </header>

    <section class="approach">
      <h2>기여 방식</h2>
      <ol>
        <li>
          <span class="step-no">1</span>
          <div>
            <p class="step-title">재현</p>
            <p class="step-desc">
              실제 프로젝트에서 마주친 이상 동작을 최소 재현 코드로 좁힙니다. 라이브러리 내부 로직을 먼저 의심하지 않고,
              먼저 제 코드가 잘못 쓰고 있는 건 아닌지 문서와 대조해 배제합니다.
            </p>
          </div>
        </li>
        <li>
          <span class="step-no">2</span>
          <div>
            <p class="step-title">근본 원인 추적</p>
            <p class="step-desc">
              재현이 확인되면 라이브러리 소스를 직접 읽어 어느 조건에서, 왜 그렇게 동작하는지 원인을 특정합니다.
              증상만 설명하는 이슈보다 원인과 재현 조건을 함께 적습니다.
            </p>
          </div>
        </li>
        <li>
          <span class="step-no">3</span>
          <div>
            <p class="step-title">이슈 등록 · PR 제출</p>
            <p class="step-desc">
              가능하면 수정까지 직접 제안합니다. 메인테이너가 판단할 수 있도록 기존 동작을 바꿀 때의 사이드
              이펙트도 함께 남깁니다.
            </p>
          </div>
        </li>
      </ol>
    </section>

    <div class="repos">
      {
        openSource.map((repo) => (
          <section class="repo">
            <div class="repo-info">
              <h2>{repo.repo}</h2>
              <p class="repo-desc">
                {repo.items.length}건의 이슈 리포트·PR로 기여했습니다.
              </p>
              <span class="count">{repo.items.length} PRs</span>
              <a class="repo-link" href={repoUrl(repo.repo)} target="_blank" rel="noreferrer">
                GitHub 저장소 ↗
              </a>
            </div>
            <ul class="repo-items">
              {repo.items.map((item, i) => (
                <li>
                  <span class="item-index">PR {pad(i + 1)}</span>
                  <div class="item-main">
                    <p class="item-title">
                      {item.title}{" "}
                      <span class="item-ref">
                        {repoShort(repo.repo)} {prNumber(item.pr)}
                      </span>
                    </p>
                    <p class="item-desc">{item.desc}</p>
                  </div>
                  <a class="item-pr" href={item.pr} target="_blank" rel="noreferrer">
                    {prNumber(item.pr)} ↗
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </main>

  <style>
    main {
      max-width: 960px;
      margin: 0 auto;
      padding: 3rem 2rem 4rem;
    }
    .back {
      font-size: 0.85rem;
      color: var(--text-muted);
    }
    .page-header {
      margin: 1.6rem 0 2rem;
    }
    .eyebrow {
      font-size: 0.78rem;
      color: var(--text-muted);
      margin: 0 0 0.5rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }
    h1 {
      font-size: 1.7rem;
      margin: 0;
      color: var(--text-heading);
    }

    .banner {
      display: block;
      width: 100%;
      border-radius: 14px;
      border: 1px solid var(--border);
      margin-bottom: 2.5rem;
    }

    .approach {
      margin-bottom: 2.8rem;
      padding-bottom: 2.5rem;
      border-bottom: 1px solid var(--border);
    }
    .approach h2 {
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--text-muted);
      margin: 0 0 1.3rem;
    }
    .approach ol {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.6rem;
    }
    .approach li {
      display: flex;
      gap: 0.8rem;
      align-items: flex-start;
    }
    .step-no {
      flex: 0 0 auto;
      width: 22px;
      height: 22px;
      border-radius: 50%;
      border: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--text-muted);
    }
    .step-title {
      font-weight: 600;
      font-size: 0.9rem;
      color: var(--text-heading);
      margin: 0 0 0.35rem;
    }
    .step-desc {
      font-size: 0.82rem;
      color: var(--text-muted);
      margin: 0;
      line-height: 1.5;
    }

    @media (max-width: 720px) {
      .approach ol {
        grid-template-columns: 1fr;
      }
    }

    .repo {
      display: grid;
      grid-template-columns: 210px 1fr;
      gap: 2rem;
      align-items: start;
      padding-bottom: 2.8rem;
      margin-bottom: 2.8rem;
      border-bottom: 1px solid var(--border);
    }
    .repo:last-child {
      margin-bottom: 0;
      padding-bottom: 0;
      border-bottom: none;
    }
    .repo-info {
      position: sticky;
      top: 1.5rem;
    }
    .repo-info h2 {
      font-size: 1.05rem;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-weight: 700;
      color: var(--text-heading);
      margin: 0 0 0.5rem;
      word-break: break-word;
    }
    .repo-desc {
      font-size: 0.85rem;
      color: var(--text-muted);
      margin: 0 0 0.8rem;
    }
    .count {
      display: block;
      font-size: 0.78rem;
      color: var(--text-muted);
      margin-bottom: 0.6rem;
    }
    .repo-link {
      display: inline-block;
      font-size: 0.78rem;
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 0.3rem 0.8rem;
      color: var(--text);
      white-space: nowrap;
    }
    .repo-link:hover {
      border-color: var(--accent);
      color: var(--accent);
      text-decoration: none;
    }

    .repo-items {
      list-style: none;
      margin: 0;
      padding: 0 0 0 1.6rem;
      border-left: 2px solid var(--border);
      min-width: 0;
    }
    .repo-items li {
      display: flex;
      align-items: flex-start;
      gap: 1.2rem;
      padding: 1.1rem 0;
      border-bottom: 1px dashed var(--border);
    }
    .repo-items li:last-child {
      border-bottom: none;
    }
    .item-index {
      flex: 0 0 auto;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.75rem;
      color: var(--text-muted);
      padding-top: 0.15rem;
    }
    .item-main {
      flex: 1;
      min-width: 0;
    }
    .item-title {
      font-weight: 600;
      font-size: 0.92rem;
      color: var(--text);
      margin: 0 0 0.35rem;
    }
    .item-ref {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-weight: 400;
      font-size: 0.78rem;
      color: var(--text-muted);
    }
    .item-desc {
      font-size: 0.86rem;
      color: var(--text-muted);
      margin: 0;
      max-width: 65ch;
    }
    .item-pr {
      flex: 0 0 auto;
      font-size: 0.8rem;
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 0.25rem 0.7rem;
      color: var(--text);
      white-space: nowrap;
    }
    .item-pr:hover {
      border-color: var(--accent);
      color: var(--accent);
      text-decoration: none;
    }

    @media (max-width: 640px) {
      .repo {
        grid-template-columns: 1fr;
        gap: 0.8rem;
      }
      .repo-info {
        position: static;
      }
      .repo-items {
        padding-left: 1rem;
      }
    }
    @media (max-width: 600px) {
      .repo-items li {
        flex-direction: column;
        gap: 0.5rem;
      }
    }
  </style>
</BaseLayout>
