---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("posts")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const [featured, ...rest] = posts;

const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]);

// 첫 화면 상단에 보여줄 가로형 타임라인 — 연도별 큰 마일스톤만
const timelineEvents: Record<string, { text: string; href: string }[]> = {
  "2015": [{ text: "옥계동부중학교 입학", href: "/about#education" }],
  "2018": [{ text: "오상고등학교 입학", href: "/about#education" }],
  "2021": [{ text: "인하대학교 컴퓨터공학과 입학", href: "/about#education" }],
  "2025": [
    { text: "모릭(Mori-Q) 프로젝트 시작", href: "/about#projects" },
    { text: "핏핏 — 탄소중립 INNOVATION ACADEMY 최우수상", href: "/about#activities" },
  ],
  "2026": [
    { text: "(주) 에듀템 웹개발팀 백엔드 인턴", href: "/about#career" },
    { text: "redisson 등 오픈소스 기여 시작", href: "/about#opensource" },
    { text: "땅보고 서비스 개발 전담", href: "/about#activities" },
    { text: "llm-markdown-sanitizer 배포", href: "/about#projects" },
  ],
};

const BIRTH_YEAR = 2002;
const CURRENT_YEAR = new Date().getFullYear();
const timeline = Array.from({ length: CURRENT_YEAR - BIRTH_YEAR + 1 }, (_, i) => {
  const year = String(BIRTH_YEAR + i);
  return { year, items: timelineEvents[year] ?? [] };
});
---

<BaseLayout title="심현민 · 글" description="백엔드 문제 해결 기록 — 동시성, 쿼리 최적화, AI 연동 아키텍처">
  <main>
    <section class="intro">
      <h1>심현민</h1>
      <p>동시성 제어, 쿼리·인덱스 최적화, 오픈소스 기여를 해온 백엔드 개발자입니다.</p>
      <div class="tags">
        <span>동시성 제어</span>
        <span>쿼리·인덱스 최적화</span>
        <span>스레드·자원 격리</span>
        <span>오픈소스 기여</span>
      </div>
    </section>

    <section class="timeline-section">
      <div class="timeline">
        {
          timeline.map((col) => (
            <div class:list={["timeline-col", { "is-empty": col.items.length === 0 }]}>
              <span class="timeline-year">{col.year}</span>
              <span class="timeline-tick" />
              <ul class="timeline-items">
                {col.items.map((item) => (
                  <li>
                    <a href={item.href}>{item.text}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    {
      featured && (
        <a class="featured-card" href={`/posts/${featured.id}/`}>
          <div class="featured-cover">
            {featured.data.cover ? (
              <img src={featured.data.cover} alt="" />
            ) : (
              <span>{featured.data.badge}</span>
            )}
          </div>
          <div class="featured-body">
            <p class="featured-label">FEATURED POST</p>
            <p class="post-meta">
              {featured.data.category} ·{" "}
              {featured.data.pubDate.toLocaleDateString("ko-KR", {
                year: "numeric",
                month: "2-digit",
                day: "2-digit",
              })}
            </p>
            <h2>{featured.data.title}</h2>
            <p class="post-desc">{featured.data.description}</p>
            {featured.data.metric && <p class="post-metric">{featured.data.metric}</p>}
          </div>
        </a>
      )
    }

    <section class="page-head">
      <h2>전체 글 <span class="count">({posts.length})</span></h2>
    </section>

    <div class="tag-filter" id="tag-filter">
      <button class="tag-chip active" data-tag="">전체 ({posts.length})</button>
      {
        tags.map(([tag, count]) => (
          <button class="tag-chip" data-tag={tag}>
            {tag} ({count})
          </button>
        ))
      }
    </div>

    <div class="post-list" id="post-grid">
      {
        rest.map((post) => (
          <a
            class="post-card"
            href={`/posts/${post.id}/`}
            data-tags={post.data.tags.join(",")}
          >
            <div class="post-cover">
              {post.data.cover ? (
                <img src={post.data.cover} alt="" />
              ) : (
                <span>{post.data.badge}</span>
              )}
            </div>
            <div class="post-body">
              <p class="post-meta">
                {post.data.category} ·{" "}
                {post.data.pubDate.toLocaleDateString("ko-KR", {
                  year: "numeric",
                  month: "2-digit",
                  day: "2-digit",
                })}
              </p>
              <h2>{post.data.title}</h2>
              <p class="post-desc">{post.data.description}</p>
              {post.data.metric && <p class="post-metric">{post.data.metric}</p>}
              <div class="post-tags">
                {post.data.tags.map((tag) => (
                  <span>{tag}</span>
                ))}
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </main>

  <script>
    const timelineEl = document.querySelector<HTMLDivElement>(".timeline");
    if (timelineEl) {
      let target = timelineEl.scrollLeft;
      let raf = 0;

      const step = () => {
        const current = timelineEl.scrollLeft;
        const diff = target - current;
        if (Math.abs(diff) < 0.5) {
          timelineEl.scrollLeft = target;
          raf = 0;
          return;
        }
        timelineEl.scrollLeft = current + diff * 0.18;
        raf = requestAnimationFrame(step);
      };

      timelineEl.addEventListener(
        "wheel",
        (e) => {
          if (Math.abs(e.deltaY) <= Math.abs(e.deltaX)) return;
          e.preventDefault();
          const max = timelineEl.scrollWidth - timelineEl.clientWidth;
          target = Math.min(Math.max(target + e.deltaY, 0), max);
          if (!raf) raf = requestAnimationFrame(step);
        },
        { passive: false },
      );
    }

    const filterEl = document.getElementById("tag-filter");
    const gridEl = document.getElementById("post-grid");
    const active = new Set<string>();

    filterEl?.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(".tag-chip");
      if (!btn) return;
      const tag = btn.dataset.tag ?? "";

      if (tag === "") {
        active.clear();
      } else {
        active.has(tag) ? active.delete(tag) : active.add(tag);
      }

      filterEl.querySelectorAll<HTMLButtonElement>(".tag-chip").forEach((el) => {
        const t = el.dataset.tag ?? "";
        el.classList.toggle("active", t === "" ? active.size === 0 : active.has(t));
      });

      gridEl?.querySelectorAll<HTMLAnchorElement>(".post-card").forEach((card) => {
        const cardTags = (card.dataset.tags ?? "").split(",");
        const visible = active.size === 0 || cardTags.some((t) => active.has(t));
        card.style.display = visible ? "" : "none";
      });
    });
  </script>

  <style>
    main {
      width: 100%;
      margin: 0 auto;
      padding: 2.5rem 2.5rem 1.5rem;
    }
    .intro h1 {
      font-size: 2rem;
      margin: 0 0 0.5rem;
      color: var(--text-heading);
    }
    .intro p {
      font-size: 1.02rem;
      color: var(--text-muted);
      margin: 0 0 1rem;
    }
    .intro .tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin-bottom: 0.5rem;
    }
    .intro .tags span {
      font-size: 0.76rem;
      color: var(--text-muted);
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 0.15rem 0.65rem;
    }

    .timeline-section {
      margin: 2rem 0 2.5rem;
      padding-top: 1.6rem;
      padding-bottom: 1.6rem;
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }
    .timeline {
      display: flex;
      gap: 2.4rem;
      overflow-x: auto;
      padding-bottom: 0.3rem;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }
    .timeline::-webkit-scrollbar {
      display: none;
    }
    .timeline-col {
      flex: 0 0 auto;
      min-width: 190px;
    }
    .timeline-col.is-empty {
      min-width: 64px;
    }
    .timeline-col.is-empty .timeline-year {
      color: var(--text-muted);
      font-weight: 600;
    }
    .timeline-col.is-empty .timeline-tick {
      width: 20px;
    }
    .timeline-year {
      display: block;
      font-weight: 700;
      font-size: 1.1rem;
      color: var(--text-heading);
      margin-bottom: 0.7rem;
    }
    .timeline-tick {
      display: block;
      position: relative;
      border-top: 1px dashed var(--border);
      margin-bottom: 0.9rem;
    }
    .timeline-tick::before {
      content: "";
      position: absolute;
      left: 0;
      top: -4px;
      width: 1px;
      height: 8px;
      background: var(--text-muted);
    }
    .timeline-items {
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .timeline-items li {
      margin-bottom: 0.55rem;
    }
    .timeline-items li:last-child {
      margin-bottom: 0;
    }
    .timeline-items a {
      color: var(--text-muted);
      font-size: 0.82rem;
      line-height: 1.5;
    }
    .timeline-items a:hover {
      color: var(--accent);
    }

    .featured-card {
      display: flex;
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 16px;
      overflow: hidden;
      margin-bottom: 3rem;
    }
    .featured-card:hover {
      border-color: var(--accent);
      text-decoration: none;
    }
    .featured-cover {
      flex: 0 0 46%;
      min-height: 320px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--tint);
      border-right: 1px solid var(--border);
      overflow: hidden;
    }
    .featured-cover img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .featured-cover span {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-weight: 700;
      font-size: 3.2rem;
      color: var(--text-muted);
    }
    .featured-body {
      flex: 1;
      min-width: 0;
      padding: 2.4rem 2.6rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .featured-label {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      color: var(--accent);
      margin: 0 0 0.8rem;
    }
    .featured-body h2 {
      font-size: 1.7rem;
      line-height: 1.4;
      margin: 0.3rem 0 0.7rem;
      color: var(--text-heading);
    }
    .featured-body .post-desc {
      font-size: 1rem;
      -webkit-line-clamp: 3;
    }

    .page-head h2 {
      font-size: 1.3rem;
      margin: 0 0 1.2rem;
      color: var(--text-heading);
    }
    .page-head .count {
      font-weight: 400;
      color: var(--text-muted);
    }

    @media (max-width: 720px) {
      .featured-card {
        flex-direction: column;
      }
      .featured-cover {
        border-right: none;
        border-bottom: 1px solid var(--border);
        min-height: 200px;
      }
    }

    .tag-filter {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-bottom: 2.5rem;
      padding-bottom: 1.6rem;
      border-bottom: 1px solid var(--border);
    }
    .tag-chip {
      font: inherit;
      font-size: 0.85rem;
      color: var(--text-muted);
      background: transparent;
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 0.4rem 1rem;
      cursor: pointer;
    }
    .tag-chip:hover {
      border-color: var(--accent);
      color: var(--accent);
    }
    .tag-chip.active {
      background: var(--accent);
      border-color: var(--accent);
      color: #fff;
    }

    .post-list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(420px, 1fr));
      gap: 2rem;
    }
    .post-card {
      display: flex;
      flex-direction: column;
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 14px;
      overflow: hidden;
    }
    .post-card:hover {
      border-color: var(--accent);
      text-decoration: none;
    }
    .post-cover {
      height: 260px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--tint);
      border-bottom: 1px solid var(--border);
      overflow: hidden;
    }
    .post-cover img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .post-cover span {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-weight: 700;
      font-size: 2.4rem;
      color: var(--text-muted);
      letter-spacing: 0.02em;
    }
    .post-body {
      padding: 1.4rem 1.5rem 1.6rem;
    }
    .post-meta {
      font-size: 0.78rem;
      color: var(--text-muted);
      margin: 0 0 0.6rem;
    }
    .post-body h2 {
      font-size: 1.3rem;
      line-height: 1.4;
      margin: 0 0 0.6rem;
      color: var(--text-heading);
    }
    .post-desc {
      font-size: 0.92rem;
      color: var(--text-muted);
      margin: 0 0 0.7rem;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .post-metric {
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--accent);
      margin: 0 0 0.7rem;
    }
    .post-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
    }
    .post-tags span {
      font-size: 0.75rem;
      color: var(--text-muted);
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 0.15rem 0.6rem;
    }
  </style>
</BaseLayout>
