---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { work } from "../data/work";
import { projects } from "../data/projects";

const posts = (await getCollection("posts")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const recentPosts = posts.slice(0, 3);

// 주력 기술 스택 — about.astro 스킬 목록과 동일, 각 항목의 "경험"은
// work.ts/projects.ts에 실제로 적힌 성과에서만 가져옴(지어낸 내용 없음)
const skills = [
  { name: "Java (Spring Boot)", exp: "동시성 제어·AOP·Executor 격리로 스레드 병목 해결" },
  { name: "JPA/Hibernate", exp: "복합 인덱스로 락 범위 축소, N+1 쿼리 제거" },
  { name: "MySQL", exp: "함수형 유니크 인덱스로 데드락 제거" },
  { name: "Redis", exp: "Redis+ARQ 백그라운드 워커, 캐시 스탬피드 방지" },
  { name: "PostgreSQL", exp: "Cloud SQL → Self-host 마이그레이션, 커넥션 풀 튜닝" },
  { name: "Docker", exp: "AWS EC2 CI/CD 파이프라인 구성" },
  { name: "AWS", exp: "EC2 기반 배포 파이프라인" },
  { name: "GCP", exp: "Cloud Run·Pub/Sub 기반 실시간 알림 파이프라인" },
];

// 일하는 방식 3가지 — 새로 지어낸 카피가 아니라 hero 문구와 프로젝트 데이터에
// 반복되는 패턴(모든 카드에 수치 비교, "격리" 키워드가 6개 contribution에 반복)에서 추출
const values = [
  {
    title: "추적",
    desc: "겉으로 드러나지 않는 병목을 코드와 실측 데이터로 끝까지 추적합니다.",
  },
  {
    title: "격리",
    desc: "장애나 병목이 생겨도 전체로 번지지 않도록 스레드·자원·트랜잭션 범위를 격리해 설계합니다.",
  },
  {
    title: "검증",
    desc: "모든 개선은 p95, 실패율 같은 수치로 before/after를 비교해 검증합니다.",
  },
];

// 프로젝트를 먼저, 그다음 경력/활동을 최신순으로 — 홈 "프로젝트 & 경력" 카드 섹션용
const featured = [
  ...projects.map((p) => ({
    href: `/projects/${p.slug}/`,
    kind: "PROJECT",
    period: p.period,
    name: p.name,
    desc: p.tag,
    logo: p.logo,
    badge: p.badge,
    imageFit: p.imageFit,
  })),
  ...work.map((w) => ({
    href: `/work/${w.slug}/`,
    kind: w.type === "경력" ? "CAREER" : "ACTIVITY",
    period: w.period,
    name: w.name,
    desc: w.role,
    logo: w.logo,
    badge: w.badge,
    imageFit: undefined as "cover" | "contain" | undefined,
  })),
];
---

<BaseLayout title="심현민 · 글" description="백엔드 문제 해결 기록 — 동시성, 쿼리 최적화, AI 연동 아키텍처">
  <main>
    <section class="intro">
      <div class="intro-glow" aria-hidden="true"></div>
      <p class="intro-eyebrow">심현민 · backend engineer</p>
      <div class="tags">
        <span>동시성 제어</span>
        <span>쿼리·인덱스 최적화</span>
        <span>스레드·자원 격리</span>
        <span>오픈소스 기여</span>
      </div>
      <h1>
        겉으로 드러나지 않는 병목을<br />
        코드와 실측 데이터로 끝까지 추적하는<br />
        <mark>백엔드 개발자</mark>입니다.
      </h1>
      <p class="intro-desc">Java·Spring Boot 기반으로 동시성 제어·쿼리·인덱스 최적화·스레드·자원 격리·비동기 아키텍처 설계를 다뤄왔고, redisson·ShedLock·langchain4j 등 오픈소스에도 기여하고 있습니다.</p>

      <div class="laptop">
        <div class="laptop-bezel">
          <span class="laptop-cam"></span>
          <div class="laptop-screen">
            <div class="term-bar"><span></span><span></span><span></span></div>
            <pre class="term-body"><code><span class="term-muted">$</span> whoami
심현민 — backend engineer

<span class="term-muted">$</span> cat philosophy.txt
겉으로 드러나지 않는 병목을
코드와 실측 데이터로 끝까지 추적합니다.

<span class="term-muted">$</span> ls stack/
Java Spring-Boot Concurrency Query-Optimization AI-Integration<span class="term-cursor"></span></code></pre>
          </div>
        </div>
        <div class="laptop-hinge"></div>
        <div class="laptop-base"></div>
      </div>
    </section>

    <section class="skills">
      <div class="section-head section-head--stack">
        <p class="section-eyebrow">SKILLS</p>
        <h2>실제로 문제를 해결하며 다뤄온 기술입니다.</h2>
      </div>
      <div class="skills-grid">
        {
          skills.map((s, i) => (
            <div class="skill-card reveal" style={`transition-delay: ${i * 70}ms`}>
              <p class="skill-name">{s.name}</p>
              <p class="skill-exp">{s.exp}</p>
            </div>
          ))
        }
      </div>
    </section>

    <div class="scroll-divider reveal" aria-hidden="true"><span class="divider-dot"></span></div>

    <section class="values">
      <div class="section-head section-head--stack">
        <p class="section-eyebrow">HOW I WORK</p>
        <h2>추적. 격리. 검증.</h2>
        <p class="section-desc">문제를 대하는 방식.</p>
      </div>
      <div class="values-grid">
        {
          values.map((v, i) => (
            <div class="value-card reveal" style={`transition-delay: ${i * 100}ms`}>
              <p class="value-index">{String(i + 1).padStart(2, "0")}</p>
              <h3>{v.title}</h3>
              <p class="value-desc">{v.desc}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="featured">
      <div class="section-head">
        <h2>프로젝트 &amp; 경력</h2>
        <a href="/about">전체 이력 보기 →</a>
      </div>
      <div class="feature-grid">
        {
          featured.map((item) => (
            <a class="feature-card reveal" href={item.href}>
              <div class:list={["feature-cover", { "is-contain": item.imageFit === "contain" }]}>
                {item.logo ? <img src={item.logo} alt="" /> : <span>{item.badge}</span>}
              </div>
              <div class="feature-body">
                <p class="feature-meta">{item.kind} · {item.period}</p>
                <h3>{item.name}</h3>
                <p class="feature-desc">{item.desc}</p>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <section class="recent-posts">
      <div class="section-head">
        <h2>최근 글</h2>
        <a href="/posts">전체 글 보기 →</a>
      </div>
      <div class="recent-grid">
        {
          recentPosts.map((post) => (
            <a class="recent-card reveal" href={`/posts/${post.id}/`}>
              <p class="recent-meta">
                {post.data.pubDate.toLocaleDateString("ko-KR", {
                  year: "numeric",
                  month: "2-digit",
                  day: "2-digit",
                })}
              </p>
              <h3>{post.data.title}</h3>
              <p class="recent-desc">{post.data.blurb ?? post.data.description}</p>
            </a>
          ))
        }
      </div>
    </section>

    <section class="cta reveal">
      <p class="cta-text">궁금한 점이 있거나 협업을 논의하고 싶다면<br />편하게 연락 주세요.</p>
      <div class="cta-links">
        <a href="mailto:shm66371945@gmail.com">이메일 보내기 →</a>
        <a href="https://github.com/stlahxm" target="_blank" rel="noreferrer">GitHub 보기 →</a>
      </div>
    </section>
  </main>

  <style>
    main {
      width: 100%;
      margin: 0 auto;
      padding: 2.5rem 2.5rem 1.5rem;
    }
    .intro {
      position: relative;
      overflow: hidden;
      text-align: left;
      padding: 4.5rem 2rem 5rem;
      margin: -2.5rem -2.5rem 3rem;
      background: radial-gradient(ellipse 80% 60% at 50% -10%, #1c2540 0%, #0a0a0d 55%, #050506 100%);
      border-radius: 0 0 28px 28px;
    }
    .intro-glow {
      position: absolute;
      top: -120px;
      left: 50%;
      width: 640px;
      height: 320px;
      transform: translateX(-50%);
      background: radial-gradient(circle, rgba(96, 165, 250, 0.35) 0%, rgba(96, 165, 250, 0) 70%);
      filter: blur(20px);
      pointer-events: none;
    }
    .intro-eyebrow {
      position: relative;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      color: #9a9aa5;
      margin: 0 0 1.4rem;
      text-transform: uppercase;
    }
    .intro h1 {
      position: relative;
      font-size: 2.7rem;
      font-weight: 800;
      line-height: 1.32;
      letter-spacing: -0.01em;
      margin: 0 0 1.2rem;
      max-width: none;
      color: #f5f5f7;
    }
    .intro h1 mark {
      background: none;
      color: #60a5fa;
    }
    .intro-desc {
      position: relative;
      font-size: 1.05rem;
      font-weight: 500;
      color: #b4b4bd;
      max-width: 56ch;
      margin: 0;
    }
    .intro .tags {
      position: relative;
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-start;
      gap: 0.5rem;
      margin: 0 0 1.6rem;
    }
    .intro .tags span {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.76rem;
      color: #b4b4bd;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 999px;
      padding: 0.3rem 0.85rem;
    }

    .laptop {
      position: relative;
      width: 100%;
      margin: 3.5rem 0 0;
    }
    .laptop-bezel {
      background: linear-gradient(180deg, #1c1c1f, #0a0a0c);
      border-radius: 16px 16px 5px 5px;
      padding: 14px 14px 10px;
      box-shadow: 0 50px 100px -30px rgba(0, 0, 0, 0.75), 0 0 0 1px rgba(255, 255, 255, 0.04) inset;
    }
    .laptop-cam {
      display: block;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #333;
      margin: 0 auto 8px;
    }
    .laptop-screen {
      background: #08080a;
      border-radius: 6px;
      padding: 1.1rem 1.2rem 1.4rem;
      text-align: left;
    }
    .term-bar {
      display: flex;
      gap: 6px;
      margin-bottom: 0.9rem;
    }
    .term-bar span {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: #333;
    }
    .term-body {
      margin: 0;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.78rem;
      line-height: 1.75;
      color: #7ee787;
      white-space: pre-wrap;
    }
    .term-muted {
      color: #666;
    }
    .term-cursor {
      display: inline-block;
      width: 6px;
      height: 0.9em;
      margin-left: 2px;
      background: #7ee787;
      vertical-align: -0.1em;
      animation: term-blink 1s step-end infinite;
    }
    @keyframes term-blink {
      50% {
        opacity: 0;
      }
    }
    .laptop-hinge {
      height: 8px;
      margin: 0 6%;
      background: linear-gradient(180deg, #111, #000);
    }
    .laptop-base {
      height: 12px;
      width: 112%;
      margin-left: -6%;
      background: linear-gradient(180deg, #2a2a2c, #111);
      border-radius: 0 0 10px 10px;
      box-shadow: 0 14px 30px -10px rgba(0, 0, 0, 0.6);
    }

    @media (max-width: 640px) {
      .intro {
        margin: -2.5rem -1.25rem 2.5rem;
        padding: 3.5rem 1.25rem 3.5rem;
      }
      .intro h1 {
        font-size: 1.6rem;
        max-width: none;
      }
    }

    .section-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 0.8rem;
      margin-bottom: 1.4rem;
    }
    .section-head h2 {
      font-size: 1.3rem;
      margin: 0;
      color: var(--text-heading);
    }
    .section-head a {
      font-size: 0.85rem;
      color: var(--text-muted);
    }
    .section-head a:hover {
      color: var(--accent);
    }
    .section-head--stack {
      display: block;
      margin-bottom: 2rem;
    }
    .section-eyebrow {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.76rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      color: var(--text-muted);
      margin: 0 0 0.6rem;
    }
    .section-head--stack h2 {
      font-size: 1.5rem;
      margin: 0 0 0.5rem;
    }
    .section-desc {
      font-size: 0.9rem;
      color: var(--text-muted);
      margin: 0;
    }

    .scroll-divider {
      display: flex;
      justify-content: center;
      margin: 4rem 0;
    }
    .divider-dot {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: var(--accent);
      box-shadow: 0 0 0 8px color-mix(in srgb, var(--accent) 14%, transparent),
        0 0 24px color-mix(in srgb, var(--accent) 40%, transparent);
      animation: divider-pulse 2.4s ease-in-out infinite;
    }
    @keyframes divider-pulse {
      0%, 100% {
        transform: scale(1);
        opacity: 1;
      }
      50% {
        transform: scale(1.2);
        opacity: 0.65;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .divider-dot {
        animation: none;
      }
    }

    .skills {
      margin: 4rem 0;
    }
    .skills-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1rem;
    }
    .skill-card {
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.1rem 1.2rem;
      transition: border-color 0.15s, transform 0.15s;
    }
    .skill-card:hover {
      border-color: var(--accent);
      transform: translateY(-2px);
    }
    .skill-name {
      font-weight: 700;
      font-size: 0.95rem;
      color: var(--text-heading);
      margin: 0 0 0.4rem;
    }
    .skill-exp {
      font-size: 0.82rem;
      color: var(--text-muted);
      line-height: 1.5;
      margin: 0;
    }

    .values {
      margin: 4rem 0;
    }
    .values-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 1.5rem;
    }
    .value-card {
      border-top: 2px solid var(--border);
      padding: 1.2rem 0 0;
      transition: border-color 0.15s;
    }
    .value-card:hover {
      border-color: var(--accent);
    }
    .value-index {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.78rem;
      color: var(--text-muted);
      margin: 0 0 0.6rem;
    }
    .value-card h3 {
      font-size: 1.15rem;
      color: var(--text-heading);
      margin: 0 0 0.6rem;
    }
    .value-desc {
      font-size: 0.88rem;
      color: var(--text-muted);
      line-height: 1.6;
      margin: 0;
    }

    .featured {
      margin: 3rem 0;
    }
    .feature-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.5rem;
    }
    .feature-card {
      display: flex;
      flex-direction: column;
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 14px;
      overflow: hidden;
      transition: border-color 0.15s, transform 0.15s, box-shadow 0.15s;
    }
    .feature-card:hover {
      border-color: var(--accent);
      text-decoration: none;
      transform: translateY(-3px);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    }
    .feature-cover {
      height: 230px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--tint);
      border-bottom: 1px solid var(--border);
      overflow: hidden;
    }
    .feature-cover.is-contain {
      background: #ffffff;
    }
    .feature-cover img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .feature-cover.is-contain img {
      object-fit: contain;
      padding: 24px;
    }
    .feature-cover span {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-weight: 700;
      font-size: 1.8rem;
      color: var(--text-muted);
    }
    .feature-body {
      padding: 1.1rem 1.25rem 1.3rem;
    }
    .feature-meta {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.72rem;
      letter-spacing: 0.03em;
      color: var(--text-muted);
      margin: 0 0 0.5rem;
    }
    .feature-body h3 {
      font-size: 1.05rem;
      line-height: 1.4;
      margin: 0 0 0.4rem;
      color: var(--text-heading);
    }
    .feature-desc {
      font-size: 0.86rem;
      color: var(--text-muted);
      margin: 0;
      line-height: 1.5;
    }

    .recent-posts {
      margin: 3rem 0 1.5rem;
    }
    .recent-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1.25rem;
    }
    .recent-card {
      display: block;
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 1.2rem 1.3rem 1.4rem;
      transition: border-color 0.15s, transform 0.15s;
    }
    .recent-card:hover {
      border-color: var(--accent);
      text-decoration: none;
      transform: translateY(-3px);
    }
    .recent-meta {
      font-size: 0.76rem;
      color: var(--text-muted);
      margin: 0 0 0.5rem;
    }
    .recent-card h3 {
      font-size: 1rem;
      line-height: 1.4;
      margin: 0 0 0.5rem;
      color: var(--text-heading);
    }
    .recent-desc {
      font-size: 0.85rem;
      color: var(--text-muted);
      margin: 0;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .cta {
      text-align: center;
      margin: 5rem 0 2rem;
      padding: 3rem 2rem;
      border-radius: 20px;
      background: var(--tint);
      border: 1px solid var(--border);
    }
    .cta-text {
      font-size: 1.15rem;
      font-weight: 600;
      color: var(--text-heading);
      line-height: 1.5;
      margin: 0 0 1.4rem;
    }
    .cta-links {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 0.8rem;
    }
    .cta-links a {
      font-size: 0.88rem;
      font-weight: 600;
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 0.55rem 1.3rem;
    }
    .cta-links a:hover {
      border-color: var(--accent);
      color: var(--accent);
      text-decoration: none;
    }
  </style>
</BaseLayout>
