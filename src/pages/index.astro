---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("posts")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="심현민 · 글" description="백엔드 문제 해결 기록 — 동시성, 쿼리 최적화, AI 연동 아키텍처">
  <main>
    <section class="page-head">
      <h1>글</h1>
      <p>문제를 어떻게 진단하고 왜 그 방식을 선택했는지 정리한 기록입니다.</p>
    </section>

    <div class="tag-filter" id="tag-filter">
      <button class="tag-chip active" data-tag="">전체 ({posts.length})</button>
      {
        tags.map(([tag, count]) => (
          <button class="tag-chip" data-tag={tag}>
            {tag} ({count})
          </button>
        ))
      }
    </div>

    <div class="post-grid" id="post-grid">
      {
        posts.map((post) => (
          <a
            class="post-card"
            href={`/posts/${post.id}/`}
            data-tags={post.data.tags.join(",")}
          >
            <div class="post-cover">
              <span>{post.data.badge}</span>
            </div>
            <div class="post-body">
              <p class="post-meta">
                {post.data.category} ·{" "}
                {post.data.pubDate.toLocaleDateString("ko-KR", {
                  year: "numeric",
                  month: "2-digit",
                })}
              </p>
              <h2>{post.data.title}</h2>
              <p class="post-desc">{post.data.description}</p>
              {post.data.metric && <p class="post-metric">{post.data.metric}</p>}
              <div class="post-tags">
                {post.data.tags.map((tag) => (
                  <span>{tag}</span>
                ))}
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </main>

  <script>
    const filterEl = document.getElementById("tag-filter");
    const gridEl = document.getElementById("post-grid");
    const active = new Set<string>();

    filterEl?.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(".tag-chip");
      if (!btn) return;
      const tag = btn.dataset.tag ?? "";

      if (tag === "") {
        active.clear();
      } else {
        active.has(tag) ? active.delete(tag) : active.add(tag);
      }

      filterEl.querySelectorAll<HTMLButtonElement>(".tag-chip").forEach((el) => {
        const t = el.dataset.tag ?? "";
        el.classList.toggle("active", t === "" ? active.size === 0 : active.has(t));
      });

      gridEl?.querySelectorAll<HTMLAnchorElement>(".post-card").forEach((card) => {
        const cardTags = (card.dataset.tags ?? "").split(",");
        const visible = active.size === 0 || cardTags.some((t) => active.has(t));
        card.style.display = visible ? "" : "none";
      });
    });
  </script>

  <style>
    main {
      max-width: var(--max-width-wide);
      margin: 0 auto;
      padding: 3.5rem 1.25rem 1rem;
    }
    .page-head h1 {
      font-size: 1.6rem;
      margin: 0 0 0.4rem;
      color: var(--text-heading);
    }
    .page-head p {
      color: var(--text-muted);
      margin: 0 0 2rem;
    }

    .tag-filter {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-bottom: 2.2rem;
      padding-bottom: 1.6rem;
      border-bottom: 1px solid var(--border);
    }
    .tag-chip {
      font: inherit;
      font-size: 0.8rem;
      color: var(--text-muted);
      background: transparent;
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 0.3rem 0.8rem;
      cursor: pointer;
    }
    .tag-chip:hover {
      border-color: var(--accent);
      color: var(--accent);
    }
    .tag-chip.active {
      background: var(--accent);
      border-color: var(--accent);
      color: #fff;
    }

    .post-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 1.5rem;
    }
    .post-card {
      display: block;
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
    }
    .post-card:hover {
      border-color: var(--accent);
      text-decoration: none;
    }
    .post-cover {
      height: 110px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--tint);
      border-bottom: 1px solid var(--border);
    }
    .post-cover span {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-weight: 700;
      font-size: 1.4rem;
      color: var(--text-muted);
      letter-spacing: 0.02em;
    }
    .post-body {
      padding: 1.1rem 1.2rem 1.3rem;
    }
    .post-meta {
      font-size: 0.75rem;
      color: var(--text-muted);
      margin: 0 0 0.5rem;
    }
    .post-body h2 {
      font-size: 1rem;
      line-height: 1.4;
      margin: 0 0 0.5rem;
      color: var(--text-heading);
    }
    .post-desc {
      font-size: 0.85rem;
      color: var(--text-muted);
      margin: 0 0 0.6rem;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .post-metric {
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--accent);
      margin: 0 0 0.7rem;
    }
    .post-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
    }
    .post-tags span {
      font-size: 0.72rem;
      color: var(--text-muted);
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 0.1rem 0.55rem;
    }
  </style>
</BaseLayout>
