---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { work } from "../data/work";
import { projects } from "../data/projects";

const posts = (await getCollection("posts")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// 목록 카드에 "경력"/"프로젝트" 대신 실제 소속(모릭, 에듀템 인턴 등)을 보여주기 위한
// postSlug -> 표시명 매핑. work는 회사명+역할, projects는 프로젝트명을 그대로 사용.
const postEntityLabel = new Map<string, string>();
for (const w of work) {
  const shortName = w.name.replace(/^\(주\)\s*/, "").split(/[ (]/)[0];
  for (const c of w.contributions) {
    if (c.postSlug) postEntityLabel.set(c.postSlug, `${shortName} ${w.role.replace(/^.*·\s*/, "").replace(/^백엔드\s*/, "")}`.trim());
  }
}
for (const p of projects) {
  const shortName = p.name.split(" (")[0];
  for (const c of p.contributions) {
    if (c.postSlug) postEntityLabel.set(c.postSlug, shortName);
  }
}

const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]);

// 첫 화면 상단에 보여줄 가로형 타임라인 — 연도별 큰 마일스톤만
const timelineEvents: Record<string, { text: string; href: string }[]> = {
  "2015": [{ text: "옥계동부중학교 입학", href: "/about#education" }],
  "2018": [{ text: "오상고등학교 입학", href: "/about#education" }],
  "2021": [{ text: "인하대학교 컴퓨터공학과 입학", href: "/about#education" }],
  "2025": [
    { text: "모릭(Mori-Q) 프로젝트 시작", href: "/about#projects" },
    { text: "핏핏 — 탄소중립 INNOVATION ACADEMY 최우수상", href: "/about#activities" },
  ],
  "2026": [
    { text: "(주) 에듀템 웹개발팀 백엔드 인턴", href: "/about#career" },
    { text: "redisson 등 오픈소스 기여 시작", href: "/about#opensource" },
    { text: "땅보고 서비스 개발 전담", href: "/about#activities" },
    { text: "llm-markdown-sanitizer 배포", href: "/about#projects" },
  ],
};

const BIRTH_YEAR = 2002;
const CURRENT_YEAR = new Date().getFullYear();
const timeline = Array.from({ length: CURRENT_YEAR - BIRTH_YEAR + 1 }, (_, i) => {
  const year = String(BIRTH_YEAR + i);
  return { year, items: timelineEvents[year] ?? [] };
});
---

<BaseLayout title="심현민 · 글" description="백엔드 문제 해결 기록 — 동시성, 쿼리 최적화, AI 연동 아키텍처">
  <main>
    <section class="intro">
      <div class="intro-glow" aria-hidden="true"></div>
      <p class="intro-eyebrow">심현민 · backend engineer</p>
      <div class="tags">
        <span>동시성 제어</span>
        <span>쿼리·인덱스 최적화</span>
        <span>스레드·자원 격리</span>
        <span>오픈소스 기여</span>
      </div>
      <h1>
        겉으로 드러나지 않는 병목을<br />
        코드와 실측 데이터로 끝까지 추적하는<br />
        <mark>백엔드 개발자</mark>입니다.
      </h1>
      <p class="intro-desc">Java·Spring Boot 기반으로 AI 연동 시스템을 개발하며, 동시성 제어·쿼리·인덱스 최적화·스레드·자원 격리·비동기 아키텍처 설계를 다뤄왔고, redisson·ShedLock·langchain4j 등 오픈소스에도 기여하고 있습니다.</p>

      <div class="laptop">
        <div class="laptop-bezel">
          <span class="laptop-cam"></span>
          <div class="laptop-screen">
            <div class="term-bar"><span></span><span></span><span></span></div>
            <pre class="term-body"><code><span class="term-muted">$</span> whoami
심현민 — backend engineer

<span class="term-muted">$</span> cat philosophy.txt
겉으로 드러나지 않는 병목을
코드와 실측 데이터로 끝까지 추적합니다.

<span class="term-muted">$</span> ls stack/
Java Spring-Boot Concurrency Query-Optimization AI-Integration<span class="term-cursor"></span></code></pre>
          </div>
        </div>
        <div class="laptop-hinge"></div>
        <div class="laptop-base"></div>
      </div>
    </section>

    <section class="timeline-section">
      <div class="timeline">
        {
          timeline.map((col) => (
            <div class:list={["timeline-col", { "is-empty": col.items.length === 0 }]}>
              <span class="timeline-year">{col.year}</span>
              <span class="timeline-tick" />
              <ul class="timeline-items">
                {col.items.map((item) => (
                  <li>
                    <a href={item.href}>{item.text}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section class="page-head" id="posts">
      <h2>전체 글 <span class="count">({posts.length})</span></h2>
      <div class="sort-toggle" id="sort-toggle">
        <button class="sort-btn active" data-sort="newest">최신순</button>
        <button class="sort-btn" data-sort="oldest">오래된순</button>
      </div>
    </section>

    <div class="tag-filter" id="tag-filter">
      <button class="tag-chip active" data-tag="">전체 ({posts.length})</button>
      {
        tags.map(([tag, count]) => (
          <button class="tag-chip" data-tag={tag}>
            {tag} ({count})
          </button>
        ))
      }
    </div>

    <div class="post-list" id="post-grid">
      {
        posts.map((post) => (
          <a
            class="post-card reveal"
            href={`/posts/${post.id}/`}
            data-tags={post.data.tags.join(",")}
            data-pubdate={post.data.pubDate.valueOf()}
          >
            <div class:list={["post-cover", { "is-logo": post.data.coverFit === "logo" }]}>
              {post.data.cover ? (
                <img src={post.data.cover} alt="" />
              ) : (
                <span>{post.data.badge}</span>
              )}
            </div>
            <div class="post-body">
              <p class="post-meta">
                {postEntityLabel.get(post.id) ?? post.data.category} ·{" "}
                {post.data.pubDate.toLocaleDateString("ko-KR", {
                  year: "numeric",
                  month: "2-digit",
                  day: "2-digit",
                })}
              </p>
              <h2>{post.data.title}</h2>
              <p class="post-desc">{post.data.blurb ?? post.data.description}</p>
              {post.data.metric && <p class="post-metric">{post.data.metric}</p>}
              <div class="post-tags">
                {post.data.tags.map((tag) => (
                  <span>{tag}</span>
                ))}
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </main>

  <script>
    const timelineEl = document.querySelector<HTMLDivElement>(".timeline");
    if (timelineEl) {
      timelineEl.scrollLeft = timelineEl.scrollWidth - timelineEl.clientWidth;
      let target = timelineEl.scrollLeft;
      let raf = 0;

      const step = () => {
        const current = timelineEl.scrollLeft;
        const diff = target - current;
        if (Math.abs(diff) < 0.5) {
          timelineEl.scrollLeft = target;
          raf = 0;
          return;
        }
        timelineEl.scrollLeft = current + diff * 0.18;
        raf = requestAnimationFrame(step);
      };

      timelineEl.addEventListener(
        "wheel",
        (e) => {
          if (Math.abs(e.deltaY) <= Math.abs(e.deltaX)) return;
          e.preventDefault();
          const max = timelineEl.scrollWidth - timelineEl.clientWidth;
          target = Math.min(Math.max(target + e.deltaY, 0), max);
          if (!raf) raf = requestAnimationFrame(step);
        },
        { passive: false },
      );
    }

    const sortEl = document.getElementById("sort-toggle");
    const gridForSort = document.getElementById("post-grid");

    sortEl?.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(".sort-btn");
      if (!btn || !gridForSort) return;
      const order = btn.dataset.sort;

      sortEl.querySelectorAll<HTMLButtonElement>(".sort-btn").forEach((el) => {
        el.classList.toggle("active", el === btn);
      });

      const cards = [...gridForSort.querySelectorAll<HTMLAnchorElement>(".post-card")];
      cards.sort((a, b) => {
        const diff = Number(a.dataset.pubdate) - Number(b.dataset.pubdate);
        return order === "oldest" ? diff : -diff;
      });
      cards.forEach((card) => gridForSort.appendChild(card));
    });

    const filterEl = document.getElementById("tag-filter");
    const gridEl = document.getElementById("post-grid");
    const active = new Set<string>();

    filterEl?.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(".tag-chip");
      if (!btn) return;
      const tag = btn.dataset.tag ?? "";

      if (tag === "") {
        active.clear();
      } else {
        active.has(tag) ? active.delete(tag) : active.add(tag);
      }

      filterEl.querySelectorAll<HTMLButtonElement>(".tag-chip").forEach((el) => {
        const t = el.dataset.tag ?? "";
        el.classList.toggle("active", t === "" ? active.size === 0 : active.has(t));
      });

      gridEl?.querySelectorAll<HTMLAnchorElement>(".post-card").forEach((card) => {
        const cardTags = (card.dataset.tags ?? "").split(",");
        const visible = active.size === 0 || cardTags.some((t) => active.has(t));
        card.style.display = visible ? "" : "none";
      });
    });
  </script>

  <style>
    main {
      width: 100%;
      margin: 0 auto;
      padding: 2.5rem 2.5rem 1.5rem;
    }
    .intro {
      position: relative;
      overflow: hidden;
      text-align: left;
      padding: 4.5rem 2rem 5rem;
      margin: -2.5rem -2.5rem 3rem;
      background: radial-gradient(ellipse 80% 60% at 50% -10%, #1c2540 0%, #0a0a0d 55%, #050506 100%);
      border-radius: 0 0 28px 28px;
    }
    .intro-glow {
      position: absolute;
      top: -120px;
      left: 50%;
      width: 640px;
      height: 320px;
      transform: translateX(-50%);
      background: radial-gradient(circle, rgba(96, 165, 250, 0.35) 0%, rgba(96, 165, 250, 0) 70%);
      filter: blur(20px);
      pointer-events: none;
    }
    .intro-eyebrow {
      position: relative;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      color: #9a9aa5;
      margin: 0 0 1.4rem;
      text-transform: uppercase;
    }
    .intro h1 {
      position: relative;
      font-size: 2.7rem;
      font-weight: 800;
      line-height: 1.32;
      letter-spacing: -0.01em;
      margin: 0 0 1.2rem;
      max-width: 19ch;
      color: #f5f5f7;
    }
    .intro h1 mark {
      background: none;
      color: #60a5fa;
    }
    .intro-desc {
      position: relative;
      font-size: 1.05rem;
      font-weight: 500;
      color: #b4b4bd;
      max-width: 56ch;
      margin: 0;
    }
    .intro .tags {
      position: relative;
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-start;
      gap: 0.5rem;
      margin: 0 0 1.6rem;
    }
    .intro .tags span {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.76rem;
      color: #b4b4bd;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 999px;
      padding: 0.3rem 0.85rem;
    }

    .laptop {
      position: relative;
      width: 100%;
      margin: 3.5rem 0 0;
    }
    .laptop-bezel {
      background: linear-gradient(180deg, #1c1c1f, #0a0a0c);
      border-radius: 16px 16px 5px 5px;
      padding: 14px 14px 10px;
      box-shadow: 0 50px 100px -30px rgba(0, 0, 0, 0.75), 0 0 0 1px rgba(255, 255, 255, 0.04) inset;
    }
    .laptop-cam {
      display: block;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #333;
      margin: 0 auto 8px;
    }
    .laptop-screen {
      background: #08080a;
      border-radius: 6px;
      padding: 1.1rem 1.2rem 1.4rem;
      text-align: left;
    }
    .term-bar {
      display: flex;
      gap: 6px;
      margin-bottom: 0.9rem;
    }
    .term-bar span {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: #333;
    }
    .term-body {
      margin: 0;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.78rem;
      line-height: 1.75;
      color: #7ee787;
      white-space: pre-wrap;
    }
    .term-muted {
      color: #666;
    }
    .term-cursor {
      display: inline-block;
      width: 6px;
      height: 0.9em;
      margin-left: 2px;
      background: #7ee787;
      vertical-align: -0.1em;
      animation: term-blink 1s step-end infinite;
    }
    @keyframes term-blink {
      50% {
        opacity: 0;
      }
    }
    .laptop-hinge {
      height: 8px;
      margin: 0 6%;
      background: linear-gradient(180deg, #111, #000);
    }
    .laptop-base {
      height: 12px;
      width: 112%;
      margin-left: -6%;
      background: linear-gradient(180deg, #2a2a2c, #111);
      border-radius: 0 0 10px 10px;
      box-shadow: 0 14px 30px -10px rgba(0, 0, 0, 0.6);
    }

    @media (max-width: 640px) {
      .intro {
        margin: -2.5rem -1.25rem 2.5rem;
        padding: 3.5rem 1.25rem 3.5rem;
      }
      .intro h1 {
        font-size: 1.6rem;
        max-width: none;
      }
    }

    .timeline-section {
      margin: 2rem 0 2.5rem;
      padding-top: 1.6rem;
      padding-bottom: 1.6rem;
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }
    .timeline {
      display: flex;
      gap: 2.4rem;
      overflow-x: auto;
      padding-bottom: 0.3rem;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }
    .timeline::-webkit-scrollbar {
      display: none;
    }
    .timeline-col {
      flex: 0 0 auto;
      min-width: 190px;
    }
    .timeline-col.is-empty {
      min-width: 64px;
    }
    .timeline-col.is-empty .timeline-year {
      color: var(--text-muted);
      font-weight: 600;
    }
    .timeline-col.is-empty .timeline-tick {
      width: 20px;
    }
    .timeline-year {
      display: block;
      font-weight: 700;
      font-size: 1.1rem;
      color: var(--text-heading);
      margin-bottom: 0.7rem;
    }
    .timeline-tick {
      display: block;
      position: relative;
      border-top: 1px dashed var(--border);
      margin-bottom: 0.9rem;
    }
    .timeline-tick::before {
      content: "";
      position: absolute;
      left: 0;
      top: -4px;
      width: 1px;
      height: 8px;
      background: var(--text-muted);
    }
    .timeline-items {
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .timeline-items li {
      margin-bottom: 0.55rem;
    }
    .timeline-items li:last-child {
      margin-bottom: 0;
    }
    .timeline-items a {
      color: var(--text-muted);
      font-size: 0.82rem;
      line-height: 1.5;
    }
    .timeline-items a:hover {
      color: var(--accent);
    }

    .page-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 0.8rem;
      margin-bottom: 1.2rem;
    }
    .page-head h2 {
      font-size: 1.3rem;
      margin: 0;
      color: var(--text-heading);
    }
    .page-head .count {
      font-weight: 400;
      color: var(--text-muted);
    }
    .sort-toggle {
      display: flex;
      gap: 0.3rem;
    }
    .sort-btn {
      font: inherit;
      font-size: 0.8rem;
      color: var(--text-muted);
      background: transparent;
      border: none;
      padding: 0.25rem 0.5rem;
      cursor: pointer;
    }
    .sort-btn:hover {
      color: var(--accent);
    }
    .sort-btn.active {
      color: var(--text-heading);
      font-weight: 700;
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .tag-filter {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-bottom: 2.5rem;
      padding-bottom: 1.6rem;
      border-bottom: 1px solid var(--border);
    }
    .tag-chip {
      font: inherit;
      font-size: 0.85rem;
      color: var(--text-muted);
      background: transparent;
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 0.4rem 1rem;
      cursor: pointer;
    }
    .tag-chip:hover {
      border-color: var(--accent);
      color: var(--accent);
    }
    .tag-chip.active {
      background: var(--accent);
      border-color: var(--accent);
      color: #fff;
    }

    .post-list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(420px, 1fr));
      gap: 2rem;
    }
    .post-card {
      display: flex;
      flex-direction: column;
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 14px;
      overflow: hidden;
      transition: border-color 0.15s, transform 0.15s, box-shadow 0.15s;
    }
    .post-card:hover {
      border-color: var(--accent);
      text-decoration: none;
      transform: translateY(-3px);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    }
    .post-cover {
      height: 260px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--tint);
      border-bottom: 1px solid var(--border);
      overflow: hidden;
    }
    .post-cover.is-logo {
      background: #ffffff;
    }
    .post-cover img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .post-cover.is-logo img {
      object-fit: contain;
      padding: 32px;
    }
    .post-cover span {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-weight: 700;
      font-size: 2.4rem;
      color: var(--text-muted);
      letter-spacing: 0.02em;
    }
    .post-body {
      padding: 1.4rem 1.5rem 1.6rem;
    }
    .post-meta {
      font-size: 0.78rem;
      color: var(--text-muted);
      margin: 0 0 0.6rem;
    }
    .post-body h2 {
      font-size: 1.3rem;
      line-height: 1.4;
      margin: 0 0 0.6rem;
      color: var(--text-heading);
    }
    .post-desc {
      font-size: 0.92rem;
      color: var(--text-muted);
      margin: 0 0 0.7rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .post-metric {
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--accent);
      margin: 0 0 0.7rem;
    }
    .post-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
    }
    .post-tags span {
      font-size: 0.75rem;
      color: var(--text-muted);
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 0.15rem 0.6rem;
    }
  </style>
</BaseLayout>
