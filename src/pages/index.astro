---

<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>심현민 · 백엔드 개발자</title>
    <meta
      name="description"
      content="동시성 제어, 쿼리·인덱스 최적화, 오픈소스 기여를 해온 백엔드 개발자 심현민의 포트폴리오"
    />
  </head>
  <body>
    <header class="site-header">
      <nav>
        <a href="#top" class="brand">심현민</a>
        <div class="nav-links">
          <a href="#career">경력</a>
          <a href="#projects">프로젝트</a>
          <a href="#opensource">오픈소스</a>
          <a href="#activities">활동</a>
          <a href={github} target="_blank" rel="noreferrer">GitHub</a>
        </div>
      </nav>
    </header>

    <main id="top">
      <section class="hero">
        <h1>심현민</h1>
        <p class="hero-role">Java, Spring Boot 기반 백엔드 개발자</p>
        <p class="hero-desc">
          동시성 제어, 쿼리·인덱스 최적화, 스레드·자원 격리, 백그라운드
          처리 구조 설계를 해왔고, redisson 등 오픈소스에도 기여하고
          있습니다. 겉으로 드러나지 않는 문제의 원인을 코드와 실측
          데이터로 끝까지 추적해 검증하는 것을 지향합니다.
        </p>
        <div class="tags">
          <span>Java (Spring Boot)</span>
          <span>JPA/Hibernate</span>
          <span>MySQL</span>
          <span>Redis</span>
          <span>PostgreSQL</span>
          <span>Docker</span>
          <span>AWS</span>
          <span>GCP</span>
        </div>
        <p class="contact-line">
          <a href={`mailto:${email}`}>{email}</a>
          <span class="dot">·</span>
          <a href={github} target="_blank" rel="noreferrer">GitHub</a>
        </p>
      </section>

      <section class="timeline-section">
        <div class="timeline">
          {
            timeline.map((col) => (
              <div class="timeline-col">
                <span class="timeline-year">{col.year}</span>
                <span class="timeline-tick" />
                <ul class="timeline-items">
                  {col.items.map((item) => (
                    <li>
                      <a href={item.anchor}>{item.text}</a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>

      <script>
        const timelineEl = document.querySelector<HTMLDivElement>(".timeline");
        timelineEl?.addEventListener(
          "wheel",
          (e) => {
            if (Math.abs(e.deltaY) <= Math.abs(e.deltaX)) return;
            e.preventDefault();
            timelineEl.scrollLeft += e.deltaY;
          },
          { passive: false },
        );
      </script>

      <section id="career" class="section">
        <h2>경력 <span class="count">({career.length} role)</span></h2>
        {
          career.map((job) => (
            <article class="card">
              <div class="card-head">
                <h3>{job.company}</h3>
                <span class="period">{job.period}</span>
              </div>
              <p class="role">{job.role}</p>
              <p class="summary">{job.summary}</p>
              <ul class="bullets">
                {job.bullets.map((b) => (
                  <li>
                    {b} <a class="detail-link" href="#">자세히 보기 ↗</a>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </section>

      <section id="projects" class="section">
        <h2>프로젝트 <span class="count">({projects.length} projects)</span></h2>
        {
          projects.map((p) => (
            <article class="card">
              <div class="card-head">
                <h3><span class="no">{p.no}</span> {p.name}</h3>
                <span class="period">{p.period}</span>
              </div>
              <p class="tag-line">{p.tag}</p>
              <div class="links">
                {p.links.map((l) => (
                  <a href={l.href} target="_blank" rel="noreferrer">{l.label} ↗</a>
                ))}
              </div>
              <p class="summary">{p.summary}</p>
              <ul class="bullets">
                {p.bullets.map((b) => (
                  <li>
                    {b} <a class="detail-link" href="#">자세히 보기 ↗</a>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </section>

      <section id="opensource" class="section">
        <h2>
          오픈소스{" "}
          <span class="count">
            ({openSource.length} repos ·{" "}
            {openSource.reduce((sum, r) => sum + r.items.length, 0)} issues)
          </span>
        </h2>
        {
          openSource.map((repo) => (
            <div class="oss-repo">
              <div class="oss-repo-head">
                <h3>{repo.repo}</h3>
                <span class="period">{repo.count}</span>
              </div>
              <ul class="oss-list">
                {repo.items.map((item) => (
                  <li>
                    <p class="oss-title">{item.title}</p>
                    <p class="oss-desc">{item.desc}</p>
                    <div class="links">
                      <a href={item.issue} target="_blank" rel="noreferrer">이슈 ↗</a>
                      <a href={item.pr} target="_blank" rel="noreferrer">PR ↗</a>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </section>

      <section id="activities" class="section">
        <h2>활동 <span class="count">({activities.length} projects)</span></h2>
        {
          activities.map((a) => (
            <article class="card">
              <div class="card-head">
                <h3>{a.title}</h3>
              </div>
              <p class="period">{a.period}</p>
              <ul class="bullets">
                {a.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </section>

      <section id="education" class="section">
        <h2>학력</h2>
        <article class="card">
          <div class="card-head">
            <h3>인하대학교</h3>
            <span class="period">2021.03 – 2027.02(졸업예정)</span>
          </div>
          <p class="summary">
            컴퓨터공학과 학사 · 전공 평점 3.91 / 4.5 (3학점만 남아 야간 병행,
            즉시 근무 가능)
          </p>
        </article>
      </section>
    </main>

    <footer class="site-footer">
      <p>
        <a href={`mailto:${email}`}>{email}</a>
        <span class="dot">·</span>
        <a href={github} target="_blank" rel="noreferrer">GitHub</a>
      </p>
      <p class="copyright">© 2026 심현민</p>
    </footer>

    <style>
      :root {
        --bg: #ffffff;
        --border: #e5e5e5;
        --text: #1a1a1a;
        --text-muted: #767676;
        --text-heading: #111111;
        --accent: #2563eb;
        --max-width: 640px;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #0b0b0c;
          --border: #262626;
          --text: #e6e6e6;
          --text-muted: #8a8a8a;
          --text-heading: #ffffff;
          --accent: #60a5fa;
        }
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: -apple-system, BlinkMacSystemFont, "Apple SD Gothic Neo",
          "Segoe UI", sans-serif;
        line-height: 1.65;
        font-size: 15px;
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: var(--accent);
        text-decoration: none;
      }
      a:hover {
        text-decoration: underline;
      }

      .site-header {
        border-bottom: 1px solid var(--border);
      }
      .site-header nav {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 1.1rem 1.25rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
      }
      .brand {
        font-weight: 600;
        color: var(--text-heading);
      }
      .nav-links {
        display: flex;
        gap: 1.1rem;
        font-size: 0.85rem;
      }
      .nav-links a {
        color: var(--text-muted);
      }
      .nav-links a:hover {
        color: var(--accent);
      }

      main {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 3.5rem 1.25rem 1rem;
      }

      .hero h1 {
        font-size: 1.9rem;
        font-weight: 700;
        margin: 0 0 0.3rem;
        color: var(--text-heading);
      }
      .hero-role {
        color: var(--text-muted);
        font-size: 0.95rem;
        margin: 0 0 1.1rem;
      }
      .hero-desc {
        color: var(--text);
        max-width: 58ch;
        margin: 0 0 1.3rem;
      }
      .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin: 0 0 1.3rem;
      }
      .tags span {
        font-size: 0.76rem;
        color: var(--text-muted);
        border: 1px solid var(--border);
        border-radius: 999px;
        padding: 0.15rem 0.65rem;
      }
      .contact-line {
        color: var(--text-muted);
        font-size: 0.88rem;
      }
      .dot {
        margin: 0 0.4rem;
      }

      .timeline-section {
        margin-top: 2.8rem;
        padding-top: 1.8rem;
        border-top: 1px solid var(--border);
        max-width: 100vw;
      }
      .timeline {
        display: flex;
        gap: 2.4rem;
        overflow-x: auto;
        padding-bottom: 0.3rem;
        scrollbar-width: none;
        -ms-overflow-style: none;
      }
      .timeline::-webkit-scrollbar {
        display: none;
      }
      .timeline-col {
        flex: 0 0 auto;
        min-width: 150px;
      }
      .timeline-year {
        display: block;
        font-weight: 700;
        font-size: 1rem;
        color: var(--text-heading);
        margin-bottom: 0.6rem;
      }
      .timeline-tick {
        display: block;
        position: relative;
        border-top: 1px dashed var(--border);
        margin-bottom: 0.9rem;
      }
      .timeline-tick::before {
        content: "";
        position: absolute;
        left: 0;
        top: -4px;
        width: 1px;
        height: 8px;
        background: var(--text-muted);
      }
      .timeline-items {
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .timeline-items li {
        margin-bottom: 0.55rem;
      }
      .timeline-items li:last-child {
        margin-bottom: 0;
      }
      .timeline-items a {
        color: var(--text-muted);
        font-size: 0.82rem;
        line-height: 1.5;
      }
      .timeline-items a:hover {
        color: var(--accent);
      }

      .section {
        margin-top: 3.2rem;
        padding-top: 1.6rem;
        border-top: 1px solid var(--border);
      }
      .section h2 {
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--text-muted);
        margin-bottom: 1.6rem;
      }
      .count {
        font-weight: 400;
        text-transform: none;
        letter-spacing: normal;
      }

      .card {
        padding-bottom: 1.8rem;
        margin-bottom: 1.8rem;
        border-bottom: 1px solid var(--border);
      }
      .card:last-child {
        border-bottom: none;
        margin-bottom: 0;
        padding-bottom: 0;
      }
      .card-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 0.75rem;
        flex-wrap: wrap;
      }
      .card-head h3 {
        margin: 0;
        font-size: 0.98rem;
        font-weight: 600;
        color: var(--text-heading);
      }
      .no {
        color: var(--text-muted);
        font-weight: 400;
        margin-right: 0.3rem;
      }
      .period {
        color: var(--text-muted);
        font-size: 0.8rem;
        white-space: nowrap;
      }
      .role,
      .tag-line {
        color: var(--text-muted);
        font-size: 0.87rem;
        margin: 0.25rem 0 0.55rem;
      }
      .summary {
        font-size: 0.89rem;
        color: var(--text);
        margin: 0.25rem 0 0.65rem;
      }
      .links {
        display: flex;
        gap: 0.8rem;
        font-size: 0.82rem;
        margin: 0.25rem 0 0.55rem;
      }

      .bullets {
        margin: 0;
        padding-left: 1.1rem;
        font-size: 0.87rem;
      }
      .bullets li {
        margin-bottom: 0.6rem;
        color: var(--text);
      }
      .bullets li:last-child {
        margin-bottom: 0;
      }
      .detail-link {
        font-size: 0.78rem;
        white-space: nowrap;
      }

      .oss-repo {
        margin-bottom: 1.8rem;
      }
      .oss-repo:last-child {
        margin-bottom: 0;
      }
      .oss-repo-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        border-bottom: 1px solid var(--border);
        padding-bottom: 0.4rem;
        margin-bottom: 0.6rem;
      }
      .oss-repo-head h3 {
        font-size: 0.9rem;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        color: var(--text-heading);
        margin: 0;
      }
      .oss-list {
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .oss-list li {
        padding: 0.7rem 0;
        border-bottom: 1px dashed var(--border);
      }
      .oss-list li:last-child {
        border-bottom: none;
      }
      .oss-title {
        font-weight: 600;
        font-size: 0.89rem;
        margin: 0 0 0.25rem;
        color: var(--text);
      }
      .oss-desc {
        font-size: 0.84rem;
        color: var(--text-muted);
        margin: 0 0 0.4rem;
      }

      .site-footer {
        max-width: var(--max-width);
        margin: 4rem auto 0;
        padding: 1.5rem 1.25rem 3rem;
        border-top: 1px solid var(--border);
        color: var(--text-muted);
        font-size: 0.85rem;
      }
      .copyright {
        margin-top: 0.4rem;
        font-size: 0.78rem;
      }

      @media (max-width: 600px) {
        .card-head {
          flex-direction: column;
          gap: 0.15rem;
        }
      }
    </style>
  </body>
</html>
