---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { work } from "../data/work";
import { projects } from "../data/projects";

const posts = (await getCollection("posts")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const recentPosts = posts.slice(0, 3);

// 주력 기술 스택 — about.astro 스킬 목록과 동일, 각 항목의 "경험"은
// work.ts/projects.ts에 실제로 적힌 성과에서만 가져옴(지어낸 내용 없음)
// color는 로고 대신 카드에 쓰는 장식용 글로우 색(실제 브랜드 컬러에 가깝게)
// Java/Spring 백엔드 롤 포지셔닝에 맞춰 핵심 스택 위주로 구성 — Python은 프로젝트별
// 스택(아래 carousel)에서만 보여주고 여기 요약 목록에선 뺐음
const skills = [
  { name: "Java", sub: "Spring Boot", exp: "동시성 제어·AOP·Executor 격리로 스레드 병목 해결", color: "#f89820" },
  { name: "JPA", sub: "Hibernate", exp: "복합 인덱스로 락 범위 축소, N+1 쿼리 제거", color: "#e8a33d" },
  { name: "QueryDSL", sub: "Query Builder", exp: "Spring Data JPA/QueryDSL로 도메인 모델링", color: "#8b5cf6" },
  { name: "JUnit5", sub: "Mockito", exp: "에듀템·모릭·핏핏 전 프로젝트 단위·통합 테스트 작성", color: "#25a162" },
  { name: "MySQL", sub: "RDB", exp: "함수형 유니크 인덱스로 데드락 제거", color: "#4479a1" },
  { name: "PostgreSQL", sub: "RDB", exp: "Cloud SQL → Self-host 마이그레이션, 커넥션 풀 튜닝", color: "#336791" },
  { name: "Redis", sub: "Cache", exp: "Redis+ARQ 백그라운드 워커, 캐시 스탬피드 방지", color: "#dc382d" },
  { name: "Docker", sub: "Infra", exp: "AWS EC2 CI/CD 파이프라인 구성", color: "#2496ed" },
  { name: "AWS", sub: "Cloud", exp: "EC2 기반 배포 파이프라인", color: "#ff9900" },
  { name: "GCP", sub: "Cloud", exp: "Cloud Run·Pub/Sub 기반 실시간 알림 파이프라인", color: "#4285f4" },
  { name: "GitHub Actions", sub: "CI/CD", exp: "gitleaks·semgrep 정적분석·시크릿 스캔 자동화", color: "#2088ff" },
  { name: "k6", sub: "Load Test", exp: "150 VU 부하테스트로 커넥션 풀 병목을 재현·검증", color: "#7d64ff" },
];

// AI 활용 방식 3가지 — 모릭(Mori-Q) 프로젝트의 실제 RAG 파이프라인 규칙(CLAUDE.md)과
// work.ts에 이미 적힌 contribution에서만 가져옴. AI 제품 기능이 아니라 AI를 다루는 태도.
const aiApproach = [
  {
    eyebrow: "3단계로 나눠 다룸",
    title: "지식 증류 → 전략 수립 → 최종 합성",
    desc: "한 번의 호출로 답을 받기보다, 자료를 압축(Distiller)하고 계획을 세운(Strategist) 뒤 마지막에 합성(Synthesizer)하는 3단계 파이프라인으로 나눠 복잡도를 구조적으로 다룹니다.",
  },
  {
    eyebrow: "출처 없는 답은 신뢰하지 않음",
    title: "할루시네이션 방어",
    desc: "temperature를 보수적으로 유지하고, 모든 생성 결과 옆에 [📄 Page n] 형식의 출처 표기를 강제해 근거 없는 답변을 걸러냅니다.",
  },
  {
    eyebrow: "느린 AI가 시스템을 막지 않게",
    title: "응답 대기와 자원 분리",
    desc: "AI 응답을 기다리는 동안 스레드·DB 커넥션이 함께 묶이지 않도록 전용 Executor와 백그라운드 워커로 격리해, AI 호출 지연이 다른 요청까지 밀어내지 않게 설계합니다.",
  },
];

// 일하는 방식 3가지 — 새로 지어낸 카피가 아니라 hero 문구와 프로젝트 데이터에
// 반복되는 패턴(모든 카드에 수치 비교, "격리" 키워드가 6개 contribution에 반복)에서 추출
const values = [
  {
    title: "추적",
    desc: "겉으로 드러나지 않는 병목을 코드와 실측 데이터로 끝까지 추적합니다.",
  },
  {
    title: "격리",
    desc: "장애나 병목이 생겨도 전체로 번지지 않도록 스레드·자원·트랜잭션 범위를 격리해 설계합니다.",
  },
  {
    title: "검증",
    desc: "모든 개선은 p95, 실패율 같은 수치로 before/after를 비교해 검증합니다.",
  },
];

// 로고 이미지는 화질·비율이 제각각이라 텍스트 중심 카드로 통일 — 배지(약어)만 표시
const featuredProjects = projects.map((p) => ({
  href: `/projects/${p.slug}/`,
  period: p.period,
  name: p.name,
  tag: p.tag,
  desc: p.summary,
  badge: p.badge,
  metrics: p.metrics.slice(0, 3),
  stack: p.stack ?? [],
}));
const featuredWork = work.map((w) => ({
  href: `/work/${w.slug}/`,
  kind: w.type,
  period: w.period,
  name: w.name,
  desc: w.role,
  badge: w.badge,
}));
---

<BaseLayout title="심현민 · 글" description="백엔드 문제 해결 기록 — 동시성, 쿼리 최적화, AI 연동 아키텍처">
  <main id="main-content">
    <section class="intro">
      <div class="intro-glow" aria-hidden="true"></div>
      <p class="intro-eyebrow">심현민 · backend engineer</p>
      <div class="tags">
        <span>동시성 제어</span>
        <span>쿼리·인덱스 최적화</span>
        <span>스레드·자원 격리</span>
        <span>오픈소스 기여</span>
      </div>
      <h1>
        겉으로 드러나지 않는 병목을<br />
        코드와 실측 데이터로 끝까지 추적하는<br />
        <mark>백엔드 개발자</mark>입니다.
      </h1>
      <p class="intro-desc">Java·Spring Boot 기반으로 동시성 제어·쿼리·인덱스 최적화·스레드·자원 격리·비동기 아키텍처 설계를 다뤄왔고, redisson·ShedLock·langchain4j 등 오픈소스에도 기여하고 있습니다.</p>

      <div class="laptop">
        <div class="laptop-bezel">
          <span class="laptop-cam"></span>
          <div class="laptop-screen">
            <div class="term-bar"><span></span><span></span><span></span></div>
            <pre class="term-body"><code><span class="term-muted">$</span> whoami
심현민 — backend engineer

<span class="term-muted">$</span> cat philosophy.txt
겉으로 드러나지 않는 병목을
코드와 실측 데이터로 끝까지 추적합니다.

<span class="term-muted">$</span> ls stack/
Java Spring-Boot Concurrency Query-Optimization AI-Integration<span class="term-cursor"></span></code></pre>
          </div>
        </div>
        <div class="laptop-hinge"></div>
        <div class="laptop-base"></div>
      </div>
    </section>

    <section class="skills">
      <div class="section-head section-head--stack">
        <p class="section-eyebrow">SKILLS</p>
        <h2>실제로 문제를 해결하며 다뤄온 기술입니다.</h2>
      </div>
      <div class="skills-row reveal">
        {
          skills.map((s) => (
            <div class="skill-pill" style={`--sc: ${s.color}`} tabindex="0" aria-label={`${s.name}: ${s.exp}`}>
              <span class="skill-pill-dot" aria-hidden="true" />
              <span class="skill-pill-name">{s.name}</span>
              <div class="skill-tooltip" role="tooltip" aria-hidden="true">
                <span class="skill-tooltip-sub">{s.sub}</span>
                <span>{s.exp}</span>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <div class="scroll-divider reveal" aria-hidden="true"><span class="divider-dot"></span></div>

    <section class="values">
      <div class="section-head section-head--stack">
        <p class="section-eyebrow">HOW I WORK</p>
        <h2>추적. 격리. 검증.</h2>
        <p class="section-desc">문제를 대하는 방식.</p>
      </div>
      <div class="values-grid">
        {
          values.map((v, i) => (
            <div class="value-card reveal" style={`transition-delay: ${i * 100}ms`}>
              <p class="value-index">{String(i + 1).padStart(2, "0")}</p>
              <h3>{v.title}</h3>
              <p class="value-desc">{v.desc}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="ai-section">
      <div class="ai-grid-bg" aria-hidden="true" />
      <div class="section-head section-head--stack">
        <p class="section-eyebrow">HOW I USE AI</p>
        <h2>AI를 도구가 아니라<br />파이프라인으로 다룹니다.</h2>
      </div>
      <div class="ai-cards">
        {
          aiApproach.map((a, i) => (
            <div class="ai-card reveal" style={`transition-delay: ${i * 110}ms`}>
              <p class="ai-index">{String(i + 1).padStart(2, "0")}</p>
              <p class="ai-eyebrow">{a.eyebrow}</p>
              <h3>{a.title}</h3>
              <p class="ai-desc">{a.desc}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="featured">
      <div class="section-head">
        <h2>프로젝트</h2>
        <a href="/about#projects">전체 이력 보기 →</a>
      </div>
      <div class="carousel">
        <div class="carousel-track" id="project-track">
          {
            featuredProjects.map((item) => (
              <a class="carousel-slide" href={item.href}>
                <span class="feature-badge">{item.badge}</span>
                <p class="feature-meta">PROJECT · {item.period}</p>
                <h3>{item.name}</h3>
                <p class="carousel-tag">{item.tag}</p>
                <p class="feature-desc">{item.desc}</p>
                {item.stack.length > 0 && (
                  <div class="carousel-stack">
                    {item.stack.map((s) => <span>{s}</span>)}
                  </div>
                )}
                <div class="carousel-metrics">
                  {item.metrics.map((m) => (
                    <span><strong>{m.value}</strong>{m.label}</span>
                  ))}
                </div>
              </a>
            ))
          }
        </div>
        <div class="carousel-controls">
          <button class="carousel-btn" id="carousel-prev" aria-label="이전 프로젝트">←</button>
          <div class="carousel-dots" id="carousel-dots">
            {featuredProjects.map((_, i) => <button class="carousel-dot" data-index={i} aria-label={`${i + 1}번째 프로젝트로 이동`} />)}
          </div>
          <button class="carousel-btn" id="carousel-next" aria-label="다음 프로젝트">→</button>
        </div>
      </div>
    </section>

    <section class="career">
      <div class="section-head">
        <h2>경력 &amp; 활동</h2>
        <a href="/about#career">전체 이력 보기 →</a>
      </div>
      <div class="feature-grid">
        {
          featuredWork.map((w, i) => (
            <a class="feature-card reveal" href={w.href} style={`transition-delay: ${i * 80}ms`}>
              <span class="feature-badge">{w.badge}</span>
              <p class="feature-meta">{w.kind.toUpperCase()} · {w.period}</p>
              <h3>{w.name}</h3>
              <p class="feature-desc">{w.desc}</p>
            </a>
          ))
        }
      </div>
    </section>

    <section class="recent-posts">
      <div class="section-head">
        <h2>최근 글</h2>
        <a href="/posts">전체 글 보기 →</a>
      </div>
      <div class="recent-grid">
        {
          recentPosts.map((post) => (
            <a class="recent-card reveal" href={`/posts/${post.id}/`}>
              <p class="recent-meta">
                {post.data.pubDate.toLocaleDateString("ko-KR", {
                  year: "numeric",
                  month: "2-digit",
                  day: "2-digit",
                })}
              </p>
              <h3>{post.data.title}</h3>
              <p class="recent-desc">{post.data.blurb ?? post.data.description}</p>
            </a>
          ))
        }
      </div>
    </section>

    <section class="cta reveal">
      <p class="cta-text">궁금한 점이 있거나 협업을 논의하고 싶다면<br />편하게 연락 주세요.</p>
      <div class="cta-links">
        <a href="mailto:shm66371945@gmail.com">이메일 보내기 →</a>
        <a href="https://github.com/stlahxm" target="_blank" rel="noreferrer">GitHub 보기 →</a>
      </div>
    </section>
  </main>

  <script>
    const track = document.getElementById("project-track");
    const prevBtn = document.getElementById("carousel-prev");
    const nextBtn = document.getElementById("carousel-next");
    const dotsEl = document.getElementById("carousel-dots");
    if (track && prevBtn && nextBtn && dotsEl) {
      const dots = [...dotsEl.querySelectorAll<HTMLButtonElement>(".carousel-dot")];
      let index = 0;

      const update = () => {
        const slide = track.children[index] as HTMLElement | undefined;
        if (slide) track.scrollTo({ left: slide.offsetLeft, behavior: "smooth" });
        dots.forEach((d, i) => d.classList.toggle("active", i === index));
        prevBtn.toggleAttribute("disabled", index === 0);
        nextBtn.toggleAttribute("disabled", index === track.children.length - 1);
      };

      prevBtn.addEventListener("click", () => {
        index = Math.max(0, index - 1);
        update();
      });
      nextBtn.addEventListener("click", () => {
        index = Math.min(track.children.length - 1, index + 1);
        update();
      });
      dots.forEach((dot, i) => {
        dot.addEventListener("click", () => {
          index = i;
          update();
        });
      });
      track.addEventListener("keydown", (e) => {
        if (e.key === "ArrowRight") nextBtn.click();
        if (e.key === "ArrowLeft") prevBtn.click();
      });

      update();
    }
  </script>

  <style>
    main {
      width: 100%;
      margin: 0 auto;
      padding: 2.5rem 2.5rem 1.5rem;
    }
    .intro {
      position: relative;
      overflow: hidden;
      text-align: left;
      padding: 4.5rem 2rem 5rem;
      margin: -2.5rem -2.5rem 3rem;
      background: radial-gradient(ellipse 80% 60% at 50% -10%, var(--tint) 0%, var(--bg) 55%, #000000 100%);
      border-radius: 0 0 28px 28px;
    }
    .intro-glow {
      position: absolute;
      top: -120px;
      left: 50%;
      width: 640px;
      height: 320px;
      transform: translateX(-50%);
      background: radial-gradient(circle, color-mix(in srgb, var(--accent) 30%, transparent) 0%, transparent 70%);
      filter: blur(20px);
      pointer-events: none;
    }
    .intro-eyebrow {
      position: relative;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      color: var(--text-muted);
      margin: 0 0 1.4rem;
      text-transform: uppercase;
    }
    .intro h1 {
      position: relative;
      font-size: 2.7rem;
      font-weight: 800;
      line-height: 1.32;
      letter-spacing: -0.01em;
      margin: 0 0 1.2rem;
      max-width: none;
      text-wrap: balance;
      color: var(--text-heading);
    }
    .intro h1 mark {
      background: none;
      color: var(--accent);
    }
    .intro-desc {
      position: relative;
      font-size: 1.05rem;
      font-weight: 500;
      color: var(--text);
      max-width: 56ch;
      margin: 0;
    }
    .intro .tags {
      position: relative;
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-start;
      gap: 0.5rem;
      margin: 0 0 1.6rem;
    }
    .intro .tags span {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.76rem;
      color: var(--text-muted);
      background: var(--tint);
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 0.3rem 0.85rem;
    }

    .laptop {
      position: relative;
      width: 100%;
      margin: 3.5rem 0 0;
    }
    .laptop-bezel {
      background: linear-gradient(180deg, #1c1c1f, #0a0a0c);
      border-radius: 16px 16px 5px 5px;
      padding: 14px 14px 10px;
      box-shadow: 0 50px 100px -30px rgba(0, 0, 0, 0.75), 0 0 0 1px rgba(255, 255, 255, 0.04) inset;
    }
    .laptop-cam {
      display: block;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #333;
      margin: 0 auto 8px;
    }
    .laptop-screen {
      background: #08080a;
      border-radius: 6px;
      padding: 1.1rem 1.2rem 1.4rem;
      text-align: left;
    }
    .term-bar {
      display: flex;
      gap: 6px;
      margin-bottom: 0.9rem;
    }
    .term-bar span {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: #333;
    }
    .term-body {
      margin: 0;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.78rem;
      line-height: 1.75;
      color: var(--accent);
      white-space: pre-wrap;
    }
    .term-muted {
      color: #666;
    }
    .term-cursor {
      display: inline-block;
      width: 6px;
      height: 0.9em;
      margin-left: 2px;
      background: var(--accent);
      vertical-align: -0.1em;
      animation: term-blink 1s step-end infinite;
    }
    @media (prefers-reduced-motion: reduce) {
      .term-cursor {
        animation: none;
      }
    }
    @keyframes term-blink {
      50% {
        opacity: 0;
      }
    }
    .laptop-hinge {
      height: 8px;
      margin: 0 6%;
      background: linear-gradient(180deg, #111, #000);
    }
    .laptop-base {
      height: 12px;
      width: 112%;
      margin-left: -6%;
      background: linear-gradient(180deg, #2a2a2c, #111);
      border-radius: 0 0 10px 10px;
      box-shadow: 0 14px 30px -10px rgba(0, 0, 0, 0.6);
    }

    @media (max-width: 640px) {
      .intro {
        margin: -2.5rem -1.25rem 2.5rem;
        padding: 3.5rem 1.25rem 3.5rem;
      }
      .intro h1 {
        font-size: 1.6rem;
        max-width: none;
      }
    }

    .section-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 0.8rem;
      margin-bottom: 1.4rem;
    }
    .section-head h2 {
      font-size: 1.3rem;
      margin: 0;
      color: var(--text-heading);
    }
    .section-head a {
      font-size: 0.85rem;
      color: var(--text-muted);
    }
    .section-head a:hover {
      color: var(--accent);
    }
    .section-head--stack {
      display: block;
      margin-bottom: 2rem;
    }
    .section-eyebrow {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.76rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      color: var(--text-muted);
      margin: 0 0 0.6rem;
    }
    .section-head--stack h2 {
      font-size: 1.5rem;
      margin: 0 0 0.5rem;
    }
    .section-desc {
      font-size: 0.9rem;
      color: var(--text-muted);
      margin: 0;
    }

    .scroll-divider {
      display: flex;
      justify-content: center;
      margin: 4rem 0;
    }
    .divider-dot {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: var(--accent);
      box-shadow: 0 0 0 8px color-mix(in srgb, var(--accent) 14%, transparent),
