---
import BaseLayout from "../layouts/BaseLayout.astro";
import { work } from "../data/work";
import { projects } from "../data/projects";
import { openSource } from "../data/opensource";

// 심현민 소개(이력서 스타일) 페이지 — 간단 요약만, 상세는 /work/[slug], /projects/[slug]로 연결.

const email = "shm66371945@gmail.com";
const github = "https://github.com/stlahxm";
const linkedin = "https://www.linkedin.com/in/simhyeonmin/";

const career = work.filter((w) => w.type === "경력");
const activities = work.filter((w) => w.type === "활동");

---

<BaseLayout
  title="심현민 · 소개"
  description="동시성 제어, 쿼리·인덱스 최적화, 오픈소스 기여를 해온 백엔드 개발자 심현민의 포트폴리오"
>
    <main id="top">
    <div class="resume-sheet">
      <header class="resume-header">
        <div class="resume-heading">
          <h1>심현민</h1>
          <p class="resume-title">Backend Engineer</p>
        </div>
        <a class="header-email" href={`mailto:${email}`}>{email}</a>
      </header>

      <p class="resume-summary">
        Java, Spring Boot 기반으로 AI 연동 시스템을 개발해온 백엔드
        개발자입니다. 동시성 제어, 쿼리·인덱스 최적화, 스레드·자원 격리,
        백그라운드 처리 구조 설계를 해왔고, redisson 등 오픈소스에도
        기여하고 있습니다. 겉으로 드러나지 않는 문제의 원인을 코드와 실측
        데이터로 끝까지 추적해 검증하는 것을 지향합니다.
      </p>

      <div class="resume-row reveal">
        <span class="resume-label">스킬</span>
        <div class="tags">
          <span>Java (Spring Boot)</span>
          <span>JPA/Hibernate</span>
          <span>MySQL</span>
          <span>Redis</span>
          <span>PostgreSQL</span>
          <span>Docker</span>
          <span>AWS</span>
          <span>GCP</span>
        </div>
      </div>

      <section id="projects" class="resume-row reveal">
        <h2 class="resume-label">프로젝트</h2>
        <div class="resume-content">
        {
          projects.map((p) => (
            <a class="project-card" href={`/projects/${p.slug}/`}>
              <div class="project-text">
                <p class="project-eyebrow">{p.no} · {p.period}</p>
                <h3 class="project-title">{p.name} <span class="entity-arrow">↗</span></h3>
                <p class="project-desc">{p.summary}</p>
                <div class="project-metrics">
                  {p.metrics.map((m) => (
                    <span><strong>{m.value}</strong> {m.label}</span>
                  ))}
                </div>
              </div>
              <div class:list={["project-image", { "is-contain": p.imageFit === "contain" }]}>
                {p.logo ? <img src={p.logo} alt="" /> : p.badge}
              </div>
            </a>
          ))
        }
        </div>
      </section>

      <section id="career" class="resume-row reveal">
        <h2 class="resume-label">경력</h2>
        <div class="resume-content">
        {
          career.map((job) => (
            <a class="entity-row" href={`/work/${job.slug}/`}>
              <span class="entity-logo">
                {job.logo ? <img src={job.logo} alt="" /> : job.badge}
              </span>
              <span class="entity-main">
                <span class="entity-name">{job.name}</span>
                <span class="entity-sub">{job.role}</span>
              </span>
              <span class="period">{job.period}</span>
              <span class="entity-arrow">↗</span>
            </a>
          ))
        }
        </div>
      </section>

      <section id="opensource" class="resume-row reveal">
        <h2 class="resume-label">오픈소스</h2>
        <div class="resume-content">
        <a class="oss-all-link" href="/work/opensource/">전체 보기 ↗</a>
        {
          openSource.map((repo) => (
            <div class="oss-repo">
              <div class="oss-repo-head">
                <h3>{repo.repo}</h3>
                <span class="period">{repo.count}</span>
              </div>
              <ul class="oss-list">
                {repo.items.map((item) => (
                  <li>
                    <p class="oss-title">{item.title}</p>
                    <p class="oss-desc">{item.desc}</p>
                    <div class="links">
                      <a href={item.issue} target="_blank" rel="noreferrer">이슈 ↗</a>
                      <a href={item.pr} target="_blank" rel="noreferrer">PR ↗</a>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
        </div>
      </section>

      <section id="activities" class="resume-row reveal">
        <h2 class="resume-label">활동</h2>
        <div class="resume-content">
        {
          activities.map((a) => (
            <a class="project-card" href={`/work/${a.slug}/`}>
              <div class="project-text">
                <p class="project-eyebrow">{a.period}</p>
                <h3 class="project-title">{a.name} <span class="entity-arrow">↗</span></h3>
                <p class="project-desc">{a.summary}</p>
                <div class="project-metrics">
                  {a.metrics.map((m) => (
                    <span><strong>{m.value}</strong> {m.label}</span>
                  ))}
                </div>
              </div>
              <div class:list={["project-image", { "is-contain": a.imageFit === "contain" }]}>
                {a.logo ? <img src={a.logo} alt="" /> : a.badge}
              </div>
            </a>
          ))
        }
        </div>
      </section>

      <section id="volunteering" class="resume-row reveal">
        <h2 class="resume-label">봉사활동</h2>
        <div class="resume-content">
        <article class="card">
          <div class="card-head">
            <h3>SW/AI 장애청소년 멘토링 (SW중심대학사업단)</h3>
            <span class="period">2025.04 – 2026.01 · 10개월</span>
          </div>
          <p class="summary">
            장애를 가진 청소년들을 대상으로 SW/AI 교육을 지원하는 프로그램에 멘토로 참여, 교육 콘텐츠 개발과 멘토링을 수행했습니다.
          </p>
        </article>
        </div>
      </section>

      <section id="awards" class="resume-row reveal">
        <h2 class="resume-label">수상</h2>
        <div class="resume-content">
        <article class="card">
          <div class="card-head">
            <h3>AX 창업 프로그램 우수상</h3>
            <span class="period">2026.07 · 단독 참가</span>
          </div>
          <p class="summary">
            시장 조사, 비즈니스 모델(BM) 설계, 투자 유치(IR) 피칭 덱 작성을 주도하며 아이디어의 시장성 검증 프로세스를 경험했습니다. 직접 사용자 피드백을 수집하고 지속적으로 개선점을 제품 기획에 반영하며 비즈니스 관점의 고객 중심 사고를 체득했습니다.
          </p>
        </article>
        </div>
      </section>

      <section id="clubs" class="resume-row reveal">
        <h2 class="resume-label">단체</h2>
        <div class="resume-content">
        <article class="card">
          <div class="card-head">
            <h3>UMC (University MakeUs Challenge) 7th</h3>
            <span class="period">2025.03 – 2025.08 · Server</span>
          </div>
          <p class="summary">대학생 IT 연합 동아리 UMC 7기 Server 파트로 활동</p>
        </article>
        </div>
      </section>

      <section id="education" class="resume-row reveal">
        <h2 class="resume-label">학력</h2>
        <div class="resume-content">
        <article class="card">
          <div class="card-head">
            <h3>인하대학교</h3>
            <span class="period">2021.03 – 2027.02(졸업예정)</span>
          </div>
          <p class="summary">
            컴퓨터공학과 학사 · 전공 평점 3.91 / 4.5 (3학점만 남아 야간 병행,
            즉시 근무 가능)
          </p>
        </article>
        </div>
      </section>

      <section id="contact" class="resume-row reveal">
        <h2 class="resume-label">Contact</h2>
        <div class="resume-content">
          <div class="contact-links">
            <a href={`mailto:${email}`} aria-label="이메일 보내기" title={email}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2.5" y="4.5" width="19" height="15" rx="2.5" />
                <path d="m3.5 6 8.5 6.5L20.5 6" />
              </svg>
            </a>
            <a href={github} target="_blank" rel="noreferrer" aria-label="GitHub" title="GitHub">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.88-1.54-3.88-1.54-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.75 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.64 1.59.24 2.76.12 3.05.74.8 1.18 1.83 1.18 3.09 0 4.43-2.7 5.4-5.27 5.69.42.36.78 1.07.78 2.15 0 1.56-.01 2.81-.01 3.19 0 .31.21.67.8.56A10.52 10.52 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" />
              </svg>
            </a>
            <a href={linkedin} target="_blank" rel="noreferrer" aria-label="LinkedIn" title="LinkedIn">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.38-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45Z" />
              </svg>
            </a>
          </div>
        </div>
      </section>
    </div>
    </main>

    <style>
      main {
        width: 100%;
        margin: 0;
        padding: 2.5rem 2rem 4rem;
      }

      .resume-sheet {
        width: 100%;
        max-width: 900px;
        background: transparent;
        padding: 0;
      }

      .resume-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        flex-wrap: wrap;
        gap: 1rem;
        padding-bottom: 2.2rem;
        margin-bottom: 2.2rem;
      }
      .resume-heading h1 {
        font-size: 3rem;
        font-weight: 800;
        margin: 0 0 0.3rem;
        color: var(--text-heading);
        letter-spacing: -0.02em;
        line-height: 1;
      }
      .resume-title {
        margin: 0;
        color: var(--text-muted);
        font-size: 0.95rem;
      }
      .header-email {
        font-size: 0.9rem;
        color: var(--text-muted);
      }
      .header-email:hover {
        color: var(--accent);
      }
      .contact-links {
        display: flex;
        gap: 0.9rem;
      }
      .contact-links a {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 42px;
        border-radius: 50%;
        border: 1px solid var(--border);
        color: var(--text);
      }
      .contact-links a:hover {
        border-color: var(--accent);
        color: var(--accent);
        text-decoration: none;
      }
      .contact-links svg {
        width: 19px;
        height: 19px;
      }

      .resume-summary {
        font-size: 0.92rem;
        color: var(--text);
        max-width: 68ch;
        margin: 0 0 1.8rem;
      }

      .resume-row {
        display: grid;
        grid-template-columns: 140px 1fr;
        gap: 1.5rem;
        padding: 2.8rem 0;
        border-top: 1px solid var(--border);
      }
      .resume-label {
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--text-muted);
        margin: 0;
      }
      .resume-content {
        min-width: 0;
      }

      .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
      }
      .tags span {
        font-size: 0.8rem;
        color: var(--text-muted);
      }
      .tags span:not(:last-child)::after {
        content: "·";
        margin-left: 0.7rem;
        color: var(--border);
      }

      .card {
        padding-bottom: 1.8rem;
        margin-bottom: 1.8rem;
        border-bottom: 1px solid var(--border);
      }
      .card:last-child {
        border-bottom: none;
        margin-bottom: 0;
        padding-bottom: 0;
      }
      .card-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 0.75rem;
        flex-wrap: wrap;
      }
      .card-head h3 {
        margin: 0;
        font-size: 0.98rem;
        font-weight: 600;
        color: var(--text-heading);
      }
      .no {
        color: var(--text-muted);
        font-weight: 400;
        margin-right: 0.3rem;
      }
      .period {
        color: var(--text-muted);
        font-size: 0.8rem;
        white-space: nowrap;
      }
      .summary {
        font-size: 0.89rem;
        color: var(--text);
        margin: 0.25rem 0 0.65rem;
      }
      .links {
        display: flex;
        gap: 0.8rem;
        font-size: 0.82rem;
        margin: 0.25rem 0 0.55rem;
      }

      .project-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2.5rem;
        padding: 2rem 0;
        border-bottom: 1px solid var(--border);
        color: var(--text);
      }
      .project-card:last-child {
        border-bottom: none;
      }
      .project-card:hover {
        text-decoration: none;
      }
      .project-card:hover .project-title {
        color: var(--accent);
      }
      .project-text {
        flex: 1;
        min-width: 0;
      }
      .project-eyebrow {
        font-size: 0.78rem;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        color: var(--text-muted);
        margin: 0 0 0.5rem;
      }
      .project-title {
        font-size: 1.3rem;
        font-weight: 700;
        color: var(--text-heading);
        margin: 0 0 0.7rem;
      }
      .project-title .entity-arrow {
        font-size: 1rem;
        font-weight: 400;
      }
      .project-desc {
        font-size: 0.9rem;
        color: var(--text-muted);
        max-width: 60ch;
        margin: 0 0 1rem;
      }
      .project-metrics {
        display: flex;
        flex-wrap: wrap;
        gap: 1.6rem;
      }
      .project-metrics span {
        font-size: 0.8rem;
        color: var(--text-muted);
      }
      .project-metrics strong {
        display: block;
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--text-heading);
      }
      .project-image {
        flex: 0 0 360px;
        height: 200px;
        border-radius: 10px;
        background: #ffffff;
        border: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-weight: 700;
        color: var(--text-muted);
      }
      .project-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .project-image.is-contain img {
        object-fit: contain;
        padding: 20px;
        box-sizing: border-box;
      }

      @media (max-width: 700px) {
        .project-card {
          flex-direction: column;
          align-items: stretch;
        }
        .project-image {
          flex: 0 0 auto;
          width: 100%;
        }
      }

      .entity-row {
        display: flex;
        align-items: center;
        gap: 1.3rem;
        padding: 1.5rem 0;
        border-bottom: 1px solid var(--border);
        color: var(--text);
      }
      .entity-row:last-child {
        border-bottom: none;
      }
      .entity-row:hover {
        text-decoration: none;
      }
      .entity-row:hover .entity-name {
        color: var(--accent);
      }
      .entity-logo {
        flex: 0 0 72px;
        height: 72px;
        border-radius: 10px;
        background: #ffffff;
        border: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.72rem;
        font-weight: 700;
        color: var(--text-muted);
      }
      .entity-logo img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        padding: 12px;
      }
      .entity-main {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
      }
      .entity-name {
        font-weight: 700;
        font-size: 1.1rem;
        color: var(--text-heading);
      }
      .entity-sub {
        font-size: 0.88rem;
        color: var(--text-muted);
      }
      .entity-arrow {
        color: var(--text-muted);
      }

      .oss-all-link {
        display: inline-block;
        font-size: 0.85rem;
        margin-bottom: 1.2rem;
      }
      .oss-repo {
        margin-bottom: 1.8rem;
      }
      .oss-repo:last-child {
        margin-bottom: 0;
      }
      .oss-repo-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid var(--border);
        padding-bottom: 0.4rem;
        margin-bottom: 0.6rem;
      }
      .oss-repo-head .period {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-weight: 600;
        color: var(--accent);
        border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
        border-radius: 999px;
        padding: 0.2rem 0.7rem;
      }
      .oss-repo-head h3 {
        font-size: 0.9rem;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        color: var(--text-heading);
        margin: 0;
      }
      .oss-list {
        list-style: none;
        margin: 0;
        padding-left: 1.2rem;
        border-left: 2px solid var(--border);
      }
      .oss-list li {
        padding: 0.7rem 0;
        border-bottom: 1px dashed var(--border);
      }
      .oss-list li:last-child {
        border-bottom: none;
      }
      .oss-title {
        font-weight: 600;
        font-size: 0.89rem;
        margin: 0 0 0.25rem;
        color: var(--text);
      }
      .oss-desc {
        font-size: 0.84rem;
        color: var(--text-muted);
        margin: 0 0 0.4rem;
      }

      @media (max-width: 600px) {
        .card-head {
          flex-direction: column;
          gap: 0.15rem;
        }
      }
    </style>
</BaseLayout>
