---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content } = await render(post);

const others = allPosts
  .filter((p) => p.id !== post.id)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const related = others.filter((p) =>
  p.data.tags.some((t) => post.data.tags.includes(t))
);
const relatedPosts = (related.length > 0 ? related : others).slice(0, 3);
---

<BaseLayout title={`${post.data.title} · 심현민`} description={post.data.description}>
  <main id="main-content">
    <a class="back" href="/">← 글 목록</a>
    {post.data.cover && (
      <div class:list={["cover-frame", { "is-logo": post.data.coverFit === "logo" }]}>
        <img src={post.data.cover} alt={post.data.title} />
      </div>
    )}
    <p class="post-meta">
      {post.data.category} ·{" "}
      {post.data.pubDate.toLocaleDateString("ko-KR", { year: "numeric", month: "2-digit", day: "2-digit" })}
    </p>
    <h1>{post.data.title}</h1>
    {post.data.metric && <p class="post-metric">{post.data.metric}</p>}
    <div class="post-tags">
      {post.data.tags.map((tag) => <span>{tag}</span>)}
    </div>
    <article class="prose">
      <Content />
    </article>

    {
      post.data.stats && post.data.stats.length > 0 && (
        <section class="stats-highlight">
          <p class="stats-eyebrow">핵심 성과</p>
          <div class="stats-grid">
            {post.data.stats.map((s) => (
              <div class="stat">
                <p class="stat-value">{s.value}</p>
                <p class="stat-label">{s.label}</p>
              </div>
            ))}
          </div>
        </section>
      )
    }

    <section class="more-posts">
      <p class="more-posts-eyebrow">{related.length > 0 ? "관련 글" : "다른 글"}</p>
      <div class="more-posts-grid">
        {
          relatedPosts.map((p) => (
            <a class="more-post-card" href={`/posts/${p.id}/`}>
              <div class:list={["more-post-cover", { "is-logo": p.data.coverFit === "logo" }]}>
                {p.data.cover ? <img src={p.data.cover} alt={p.data.title} loading="lazy" /> : <span>{p.data.badge}</span>}
              </div>
              <div class="more-post-body">
                <p class="more-post-meta">
                  {p.data.category} ·{" "}
                  {p.data.pubDate.toLocaleDateString("ko-KR", {
                    year: "numeric",
                    month: "2-digit",
                    day: "2-digit",
                  })}
                </p>
                <p class="more-post-title">{p.data.title}</p>
              </div>
            </a>
          ))
        }
      </div>
      <a class="all-posts-link" href="/">전체 글 보기 →</a>
    </section>
  </main>

  <style>
    main {
      max-width: var(--max-width-wide);
      margin: 0 auto;
      padding: 3rem 2rem 4rem;
    }
    .back {
      font-size: 0.85rem;
      color: var(--text-muted);
    }
    .cover-frame {
      width: 100%;
      height: 260px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--tint);
      border-radius: 14px;
      border: 1px solid var(--border);
      margin: 1.2rem 0 0;
      overflow: hidden;
    }
    .cover-frame.is-logo {
      background: #ffffff;
    }
    .cover-frame img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .cover-frame.is-logo img {
      width: auto;
      height: auto;
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
      padding: 32px;
      box-sizing: border-box;
    }
    .post-meta {
      font-size: 0.8rem;
      color: var(--text-muted);
      margin: 1.6rem 0 0.5rem;
    }
    h1 {
      font-size: 1.5rem;
      line-height: 1.4;
      color: var(--text-heading);
      margin: 0 0 0.7rem;
    }
    .post-metric {
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--accent);
      margin: 0 0 0.9rem;
    }
    .post-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin-bottom: 2rem;
      padding-bottom: 2rem;
      border-bottom: 1px solid var(--border);
    }
    .post-tags span {
      font-size: 0.75rem;
      color: var(--text-muted);
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 0.15rem 0.65rem;
    }

    .prose {
      font-size: 0.95rem;
      line-height: 1.8;
      color: var(--text);
    }
    .prose :global(h1) {
      font-size: 1.3rem;
      color: var(--text-heading);
      margin: 2.4rem 0 0.9rem;
    }
    .prose :global(h2) {
      font-size: 1.05rem;
      color: var(--text-heading);
      margin: 2.2rem 0 0.8rem;
      padding-top: 1.6rem;
      border-top: 1px solid var(--border);
    }
    .prose :global(h2:first-child) {
      padding-top: 0;
      border-top: none;
      margin-top: 0;
    }
    .prose :global(h3) {
      font-size: 0.98rem;
      color: var(--text-heading);
      margin: 1.6rem 0 0.7rem;
    }
    .prose :global(p) {
      margin: 0 0 1rem;
    }
    .prose :global(ul),
    .prose :global(ol) {
      margin: 0 0 1rem;
      padding-left: 1.3rem;
    }
    .prose :global(li) {
      margin-bottom: 0.4rem;
    }
    .prose :global(li > ul),
    .prose :global(li > ol) {
      margin-top: 0.4rem;
    }
    .prose :global(strong) {
      color: var(--text-heading);
    }
    .prose :global(a) {
      color: var(--accent);
    }
    .prose :global(hr) {
      border: none;
      border-top: 1px solid var(--border);
      margin: 2rem 0;
    }
    .prose :global(blockquote) {
      margin: 0 0 1.4rem;
      padding: 1rem 1.3rem;
      border-left: 4px solid var(--accent);
      background: var(--tint);
      border-radius: 0 10px 10px 0;
      color: var(--text-heading);
      font-size: 1.02em;
      font-weight: 500;
    }
    .prose :global(blockquote p) {
      margin: 0;
    }
    .prose :global(blockquote p + p) {
      margin-top: 0.5rem;
    }

    /* 인라인 코드 */
    .prose :global(code) {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.85em;
      background: var(--tint);
      padding: 0.1em 0.35em;
      border-radius: 4px;
    }
    /* 코드 블록 — 인라인 code 스타일을 상쇄하고 별도 스타일 적용 */
    .prose :global(pre) {
      background: var(--tint);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 1rem 1.1rem;
      margin: 0 0 1.2rem;
      overflow-x: auto;
      font-size: 0.85em;
      line-height: 1.6;
    }
    .prose :global(pre code) {
      background: none;
      padding: 0;
      border-radius: 0;
      font-size: 1em;
    }

    /* 표 */
    .prose :global(table) {
      width: 100%;
      border-collapse: collapse;
      margin: 0 0 1.4rem;
      font-size: 0.88em;
    }
    .prose :global(th),
    .prose :global(td) {
      border: 1px solid var(--border);
      padding: 0.55rem 0.8rem;
      text-align: left;
    }
    .prose :global(th) {
      background: var(--tint);
      color: var(--text-heading);
      font-weight: 600;
    }

    /* mermaid 등 다이어그램 코드 블록은 그대로 코드로 표시 */
    .prose :global(.mermaid) {
      background: var(--tint);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 1rem;
      overflow-x: auto;
      margin: 0 0 1.2rem;
    }

    .stats-highlight {
      margin-top: 3rem;
      padding: 2.2rem 2rem;
      background: var(--tint);
      border: 1px solid var(--border);
      border-radius: 16px;
    }
    .stats-eyebrow {
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--text-muted);
      margin: 0 0 1.3rem;
    }
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 1.5rem;
    }
    .stat-value {
      font-size: 1.6rem;
      font-weight: 700;
      font-variant-numeric: tabular-nums;
      color: var(--accent);
      margin: 0 0 0.35rem;
    }
    .stat-label {
      font-size: 0.85rem;
      color: var(--text-muted);
      margin: 0;
    }

    .more-posts {
      margin-top: 3rem;
      padding-top: 2.2rem;
      border-top: 1px solid var(--border);
    }
    .more-posts-eyebrow {
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--text-muted);
      margin: 0 0 1.2rem;
    }
    .more-posts-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1.2rem;
      margin-bottom: 1.2rem;
    }
    .more-post-card {
      display: block;
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
      color: var(--text);
    }
    .more-post-card:hover {
      border-color: var(--accent);
      text-decoration: none;
    }
    .more-post-cover {
      height: 120px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      overflow: hidden;
    }
    .more-post-cover.is-logo {
      background: #ffffff;
    }
    .more-post-cover img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .more-post-cover.is-logo img {
      width: auto;
      height: auto;
      max-width: 80%;
      max-height: 80%;
      object-fit: contain;
    }
    .more-post-cover span {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-weight: 700;
      font-size: 1.6rem;
      color: var(--text-muted);
    }
    .more-post-body {
      padding: 0.9rem 1rem 1.1rem;
    }
    .more-post-meta {
      font-size: 0.74rem;
      color: var(--text-muted);
      margin: 0 0 0.35rem;
    }
    .more-post-title {
      font-size: 0.88rem;
      font-weight: 600;
      color: var(--text-heading);
      margin: 0;
      line-height: 1.4;
    }
    .all-posts-link {
      font-size: 0.85rem;
    }
  </style>
</BaseLayout>
