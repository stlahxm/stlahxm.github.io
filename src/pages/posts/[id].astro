---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} · 심현민`} description={post.data.description}>
  <main>
    <a class="back" href="/">← 글 목록</a>
    {post.data.cover && <img class="cover" src={post.data.cover} alt="" />}
    <p class="post-meta">
      {post.data.category} ·{" "}
      {post.data.pubDate.toLocaleDateString("ko-KR", { year: "numeric", month: "2-digit", day: "2-digit" })}
    </p>
    <h1>{post.data.title}</h1>
    {post.data.metric && <p class="post-metric">{post.data.metric}</p>}
    <div class="post-tags">
      {post.data.tags.map((tag) => <span>{tag}</span>)}
    </div>
    <article class="prose">
      <Content />
    </article>
  </main>

  <style>
    main {
      max-width: var(--max-width);
      margin: 0 auto;
      padding: 3rem 1.25rem 2rem;
    }
    .back {
      font-size: 0.85rem;
      color: var(--text-muted);
    }
    .cover {
      display: block;
      width: 100%;
      max-height: 320px;
      object-fit: cover;
      border-radius: 14px;
      border: 1px solid var(--border);
      margin: 1.2rem 0 0;
    }
    .post-meta {
      font-size: 0.8rem;
      color: var(--text-muted);
      margin: 1.6rem 0 0.5rem;
    }
    h1 {
      font-size: 1.5rem;
      line-height: 1.4;
      color: var(--text-heading);
      margin: 0 0 0.7rem;
    }
    .post-metric {
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--accent);
      margin: 0 0 0.9rem;
    }
    .post-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin-bottom: 2rem;
      padding-bottom: 2rem;
      border-bottom: 1px solid var(--border);
    }
    .post-tags span {
      font-size: 0.75rem;
      color: var(--text-muted);
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 0.15rem 0.65rem;
    }

    .prose {
      font-size: 0.95rem;
      line-height: 1.8;
      color: var(--text);
    }
    .prose :global(h2) {
      font-size: 1.05rem;
      color: var(--text-heading);
      margin: 2.2rem 0 0.8rem;
    }
    .prose :global(p) {
      margin: 0 0 1rem;
    }
    .prose :global(ul),
    .prose :global(ol) {
      margin: 0 0 1rem;
      padding-left: 1.3rem;
    }
    .prose :global(li) {
      margin-bottom: 0.4rem;
    }
    .prose :global(strong) {
      color: var(--text-heading);
    }
    .prose :global(code) {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.85em;
      background: var(--tint);
      padding: 0.1em 0.35em;
      border-radius: 4px;
    }
  </style>
</BaseLayout>
